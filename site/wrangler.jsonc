{
	// Cloudflare Workers config — same pattern as haxbyte.com's
	// site/wrangler.jsonc. Now has a real "main" worker script (src/worker.js)
	// handling POST /api/contact, falling back to the assets binding for
	// everything else — Contact.astro grew a real form once the domain
	// attachment below unblocked Email Routing.
	//
	// In the Cloudflare dashboard (Workers & Pages -> Create -> connect this
	// GitHub repo): set root directory (Advanced settings) to "site", build
	// command "npm run build", deploy command "npx wrangler deploy" (default,
	// picks up this file). Root directory matters because this file's
	// relative path ("./dist") resolves from wherever the dashboard's root
	// directory is set, not from the repo root.
	"name": "dougrosenbergmusic",
	"main": "./src/worker.js",
	"compatibility_date": "2026-09-06",
	// Attaches the real domain to this Worker (docs/todolist.md's domain-cutover
	// step 3) — `custom_domain: true` provisions it via the Cloudflare API on
	// deploy, same end result as doing it by hand in Workers & Pages -> Settings
	// -> Domains & Routes. Requires the dougrosenberg.com zone to already exist
	// in this account (it does — added as a Cloudflare zone during cutover).
	"routes": [
		{ "pattern": "dougrosenberg.com", "custom_domain": true },
		{ "pattern": "www.dougrosenberg.com", "custom_domain": true }
	],
	// Lets the Worker send contact-form email via Cloudflare's native Workers
	// send_email binding — no third-party account/API key needed. Requires
	// Email Routing enabled on the dougrosenberg.com zone, and
	// destination_address verified as a "Destination Address" in this
	// Cloudflare account's Email Routing settings (one-time email
	// confirmation) before sends will succeed. See src/worker.js.
	"send_email": [
		{
			"name": "CONTACT_EMAIL",
			"destination_address": "doug.rosenberg@gmail.com"
		}
	],
	"assets": {
		"directory": "./dist",
		// Without this, unmatched routes get a bare 404 with an empty body
		// instead of the built dist/404.html — Workers static assets
		// defaults to "none", unlike classic Pages which served 404.html
		// automatically. (No custom 404.astro exists yet — see
		// docs/todolist.md's checklist-pass item.)
		"not_found_handling": "404-page"
	}
}
