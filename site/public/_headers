# Cloudflare security headers — https://developers.cloudflare.com/pages/configuration/headers/
# (Workers static-assets confirmed to still honor this file, same as Pages.)
#
# CSP script-src is locked down with sha256 hashes for inline scripts instead
# of 'unsafe-inline' — Astro inlines each page-specific <script> directly into
# the HTML rather than extracting it to an external file, so each one needs
# its own hash here or it's silently blocked (the script still renders, it
# just never runs). Current 4 hashes cover: BaseLayout's Person JSON-LD,
# StaffNav's scroll/menu handler, SheetMusicLibrary's search/viewer handler,
# and Gallery's filter/lightbox handler. If any of these scripts change,
# regenerate every hash with:
#   npm run build
#   node -e "const fs=require('fs'),crypto=require('crypto');
#     for (const f of ['dist/index.html','dist/404.html']) {
#       const html=fs.readFileSync(f,'utf8');
#       const re=/<script(?![^>]*\bsrc=)[^>]*>([\s\S]*?)<\/script>/g; let m;
#       while ((m=re.exec(html))) console.log(f,
#         'sha256-'+crypto.createHash('sha256').update(m[1],'utf8').digest('base64'));
#     }"
# and dedupe the resulting list into the script-src below.
#
# style-src still needs 'unsafe-inline' for inline style="" attributes used for
# absolute-positioned nav elements (StaffNav.astro) — same trade-off haxbyte
# made. Fonts are self-hosted (site/public/fonts/) as of 2026-09-06, so unlike
# the previous version of this file, style-src/font-src no longer need to allow
# fonts.googleapis.com/fonts.gstatic.com.
#
# static.cloudflareinsights.com (script-src) / cloudflareinsights.com
# (connect-src) are for Cloudflare Web Analytics (BaseLayout.astro's beacon
# script) — same two allowances haxbyte's CSP carries for the same reason.
# Remove both if Web Analytics is ever turned off.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-zhVnbzsTA9hBiYT4iL9omDQZgs0yUjRBwDty1riqNqE=' 'sha256-zXHYpHbGo1ofrr3sb74IbCDTKXZEfTk9ciIRw469QOo=' 'sha256-XHTB+4oJMm+A6EVWYFrd4DPyVrIQ4aPzj+M5LYvSNis=' 'sha256-FtQMGXIgf+z4P4IOaJ/2Cvf8Ct+QJwemceM64BUkTFs=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Caching — Cloudflare Workers static-assets defaults every file to
# `max-age=0, must-revalidate` regardless of content, confirmed via `curl -I`
# against production (2026-09-06): even /_astro/*'s content-hashed bundles and
# self-hosted font files were forcing a revalidation round-trip on every load.
# /_astro/* filenames change automatically when their content does, so caching
# them forever is fully safe. /fonts/, /images/, and /sheetmusic/ aren't
# content-hashed - a shorter, non-"immutable" max-age here so a real asset
# swap (without a filename change) still reaches visitors within a week
# instead of a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/sheetmusic/*
  Cache-Control: public, max-age=604800
