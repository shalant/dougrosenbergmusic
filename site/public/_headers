# Cloudflare security headers — https://developers.cloudflare.com/pages/configuration/headers/
# (Workers static-assets confirmed to still honor this file, same as Pages.)
#
# CSP script-src is locked down with sha256 hashes for inline scripts instead
# of 'unsafe-inline' — Astro inlines each page-specific <script> directly into
# the HTML rather than extracting it to an external file, so each one needs
# its own hash here or it's silently blocked (the script still renders, it
# just never runs). Current 4 hashes cover: BaseLayout's Person JSON-LD,
# StaffNav's scroll/menu handler, SheetMusicLibrary's search/viewer handler,
# and Gallery's filter/lightbox handler. If any of these scripts change,
# regenerate every hash with:
#   npm run build
#   node -e "const fs=require('fs'),crypto=require('crypto');
#     for (const f of ['dist/index.html','dist/404.html']) {
#       const html=fs.readFileSync(f,'utf8');
#       const re=/<script(?![^>]*\bsrc=)[^>]*>([\s\S]*?)<\/script>/g; let m;
#       while ((m=re.exec(html))) console.log(f,
#         'sha256-'+crypto.createHash('sha256').update(m[1],'utf8').digest('base64'));
#     }"
# and dedupe the resulting list into the script-src below.
#
# style-src/font-src allow fonts.googleapis.com/fonts.gstatic.com because
# global.css still loads Google Fonts via @import, unlike haxbyte's
# self-hosted woff2 setup — see docs/todolist.md's font self-hosting item.
# Migrating to self-hosted fonts would let this drop those two allowances.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-zhVnbzsTA9hBiYT4iL9omDQZgs0yUjRBwDty1riqNqE=' 'sha256-zXHYpHbGo1ofrr3sb74IbCDTKXZEfTk9ciIRw469QOo=' 'sha256-XHTB+4oJMm+A6EVWYFrd4DPyVrIQ4aPzj+M5LYvSNis=' 'sha256-FtQMGXIgf+z4P4IOaJ/2Cvf8Ct+QJwemceM64BUkTFs='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
