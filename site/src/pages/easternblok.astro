---
// Eastern Blok archive. Out of draft 2026-10-16 once Doug confirmed the story
// below (see docs/todolist.md, "Press on the site"). The year notes on two
// albums stay visible until he settles the release years.
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import QuoteLedger from '../components/QuoteLedger.astro';
import ShowLog from '../components/ShowLog.astro';
import VideoLog from '../components/VideoLog.astro';
import { easternBlokQuotes } from '../data/press-timeline.js';
import bandArchive from '../data/eastern-blok-press.json';
import showData from '../data/eastern-blok-shows.json';

const covers: Record<string, { src: string; width: number; height: number }> = {
  'goran-ivanovic-group': { src: '/images/albums/goran-ivanovic-group.jpg', width: 522, height: 474 },
  'folk-tales': { src: '/images/albums/folk-tales.jpg', width: 500, height: 509 },
  underwater: { src: '/images/albums/underwater.jpg', width: 500, height: 500 },
};

// Release years the sources disagree on, shown on the page until Doug confirms.
const yearToConfirm: Record<string, string> = {
  'goran-ivanovic-group': 'some sources say 2005',
  'folk-tales': 'All About Jazz lists 2008',
};

// Counts come from the show list so the story can't drift from the log below it.
const showCount = showData.shows.length;
const stateCount = new Set(showData.shows.map((show) => show.region).filter((region) => region && /^[A-Z]{2}$/.test(region))).size;
const toursPoland = showData.shows.some((show) => show.region === 'Poland');

const albums = bandArchive.albums.map((album) => ({ ...album, cover: covers[album.id], yearNote: yearToConfirm[album.id] }));

const bandSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': 'https://dougrosenberg.com/easternblok#band',
  name: 'Eastern Blok',
  alternateName: 'Goran Ivanovic Group',
  url: new URL('/easternblok', Astro.site).toString(),
  location: { '@type': 'Place', name: 'Chicago, Illinois' },
  dissolutionDate: '2012',
  member: [{ '@id': 'https://dougrosenberg.com/#person' }],
  album: albums.map((album) => ({
    '@type': 'MusicAlbum',
    name: album.title,
    datePublished: String(album.year),
  })),
};
---

<ArchiveLayout
  title="Eastern Blok — Doug Rosenberg"
  description="An archive of Eastern Blok, the Chicago band that began as the Goran Ivanovic Group: albums, press and history, through 2012."
  eyebrow="Archive · Chicago · until 2012"
  heading="Eastern Blok"
  draft={false}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(bandSchema)} />
  <p slot="lead" class="archive__lead">
    The Chicago band that started as the Goran Ivanovic Group and played until 2012. Doug Rosenberg played saxophone, flute and clarinet.
  </p>

  <section class="archive__section" aria-labelledby="story">
    <h2 id="story">The story</h2>
    <p>
      Eastern Blok began as the Goran Ivanovic Group, a Chicago band led by the Croatian-born guitarist Goran Ivanovic, with Doug Rosenberg on saxophone, flute and clarinet, Matthew Ulery on bass and Michael Caskey on drums. Their first album, <cite>Goran Ivanovic Group</cite> (Balkan Song Records, 2006), mixed Balkan folk music, klezmer and jazz improvisation, and <cite>Downbeat</cite> reviewed it in June 2006. The band took the name Eastern Blok for its second album, <cite>Folk Tales</cite> (2007), and released a third, <cite>Underwater</cite>, in 2011. The show list below records {showCount} concerts from 2005 to 2012, across {stateCount} states{toursPoland && ' and Poland'}.
    </p>
    <p>
      The band's 2007 press bio quoted the <cite>Los Angeles Times</cite> calling their music “relentlessly innovative work” and <cite>Time Out</cite> calling the group “an agile Bela Fleck in Croatia.” Both quotes come from that bio; the original articles haven't been found.
    </p>
  </section>

  {/* Both photos come from the band's old site (easternblok.net) via the
      Wayback Machine; Doug approved publishing them 2026-10-18 and asked for
      Saverio Truglia to be credited. The 2007 one carries his credit on the
      image itself. The 2011 one has no credit anywhere, so its photographer
      is still unconfirmed. */}
  <section class="archive__section" aria-labelledby="photos">
    <h2 id="photos">Photos</h2>
    <div class="photos">
      <figure class="photo photo--wide">
        <img src="/images/easternblok/eastern-blok-2011.webp" width="864" height="576" alt="Eastern Blok in a studio portrait: Doug Rosenberg holding a tenor saxophone, Goran Ivanovic with a guitar, Matthew Ulery with an upright bass and Michael Caskey in a flat cap" loading="lazy" />
        <figcaption>Eastern Blok, left to right: Doug Rosenberg, Goran Ivanovic, Matthew Ulery, Michael Caskey. Band photo from easternblok.net, 2011.</figcaption>
      </figure>
      <figure class="photo">
        <img src="/images/easternblok/eastern-blok-2007.jpg" width="429" height="321" alt="The Goran Ivanovic Group in a velvet-walled room: Goran Ivanovic in the foreground with a guitar, Matthew Ulery behind an upright bass, Doug Rosenberg and Michael Caskey" loading="lazy" />
        <figcaption>The Goran Ivanovic Group. Band photo from easternblok.net, 2007. Photo: Saverio Truglia.</figcaption>
      </figure>
    </div>
    {/* Added 2026-10-23 when Doug asked for any live pictures that turned up.
        The old site's photo page had about 40 live shots, but its image files
        were never saved by the Wayback Machine, and the photographer's gallery
        (Gareth Glynn Ash, The Celtic Camera) is gone. These three are the only
        ones that survive, from easternblok.net's 2007 pages. Goran's carries a
        Saverio Truglia credit on the image; the other two have no credit
        anywhere, so their photographers are unconfirmed. They are small, so
        they are never scaled past their own width. */}
    <div class="photos photos--live">
      <figure class="photo photo--portrait" style="--w: 313px">
        <img src="/images/easternblok/doug-rosenberg-sax.jpg" width="313" height="419" alt="Doug Rosenberg on stage, eyes closed, playing a saxophone beside a microphone" loading="lazy" />
        <figcaption>Doug Rosenberg. From easternblok.net, 2007. Photographer unconfirmed.</figcaption>
      </figure>
      <figure class="photo photo--portrait" style="--w: 292px">
        <img src="/images/easternblok/goran-ivanovic-guitar.jpg" width="292" height="432" alt="Close black-and-white view of Goran Ivanovic playing a classical guitar" loading="lazy" />
        <figcaption>Goran Ivanovic. From easternblok.net, 2007. Photo: Saverio Truglia.</figcaption>
      </figure>
      <figure class="photo photo--portrait" style="--w: 233px">
        <img src="/images/easternblok/matt-ulery-bass.jpg" width="233" height="350" alt="Matthew Ulery on stage bowing an upright bass" loading="lazy" />
        <figcaption>Matthew Ulery. From easternblok.net, 2007. Photographer unconfirmed.</figcaption>
      </figure>
    </div>
  </section>

  <section class="archive__section" aria-labelledby="video">
    <h2 id="video">Video</h2>
    <VideoLog />
  </section>

  <section class="archive__section" aria-labelledby="members">
    <h2 id="members">Members</h2>
    <ul class="members">
      <li><span class="members__name">Goran Ivanovic</span><span class="members__role">guitar</span></li>
      <li><span class="members__name">Doug Rosenberg</span><span class="members__role">saxophone, flute, clarinet</span></li>
      <li><span class="members__name">Matthew Ulery</span><span class="members__role">bass</span></li>
      <li><span class="members__name">Michael Caskey</span><span class="members__role">drums</span></li>
    </ul>
  </section>

  <section class="archive__section" aria-labelledby="albums">
    <h2 id="albums">Albums</h2>
    <ul class="albums">
      {albums.map((album) => (
        <li class="album">
          {album.cover && (
            <img class="album__cover" src={album.cover.src} width={album.cover.width} height={album.cover.height} alt={`${album.title} album cover`} loading="lazy" />
          )}
          <div class="album__body">
            <h3 class="album__title">{album.title}</h3>
            <p class="album__meta">{album.year} · {album.label === 'Self Produced' ? 'self-released' : album.label}{album.band !== 'Eastern Blok' && ` · as the ${album.band}`}</p>
            {album.yearNote && <p class="album__note">Year to confirm: {album.yearNote}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="archive__section" aria-labelledby="press">
    <h2 id="press">Press</h2>
    <QuoteLedger quotes={easternBlokQuotes} />
  </section>

  <section class="archive__section" aria-labelledby="shows">
    <h2 id="shows">Shows</h2>
    <ShowLog />
  </section>
</ArchiveLayout>

<style>
  /* Lopsided on purpose: the 2011 portrait is the full-size file, the 2007
     one is only 429px wide, so it stays small instead of being blown up. */
  .photos {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
  }

  .photo {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .photo img {
    width: 100%;
    height: auto;
    border: 1px solid var(--staff-line-strong);
  }

  /* Three small portraits in a row; each is capped at its own pixel width so
     the low-resolution files are never blown up (2026-10-23). */
  .photos--live {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    margin-top: 2rem;
  }

  .photo--portrait img {
    max-width: var(--w);
  }

  .photo figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    max-width: 52ch;
  }

  @media (max-width: 700px) {
    .photos {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    /* A grid, not flex-wrap (2026-10-17): with wrapping, the longest role
       ("saxophone, flute, clarinet") pushed rows into an uneven 1-1-2 on a
       phone. Now 2x2 on a phone, one row of four when there's room. */
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1rem 1.25rem;
  }

  .members li {
    display: grid;
    gap: 0.1rem;
  }

  .members__name {
    font-family: var(--font-display);
    /* Scales down a little on the narrowest phones so "Doug Rosenberg"
       still fits its half of a 360px screen on one line. */
    font-size: clamp(1.05rem, 4.6vw, 1.2rem);
  }

  .members__role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .album {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .album__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--staff-line-strong);
  }

  .album__body {
    display: grid;
    gap: 0.25rem;
  }

  .album__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }

  .album__meta,
  .album__note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .album__note {
    color: var(--brass);
  }

  @media (max-width: 860px) {
    .albums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Rows instead of full-width covers on a phone (2026-10-17): each cover
     was about a screen and a half tall. Same pattern as the home page's
     Recordings. */
  @media (max-width: 520px) {
    .albums {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .album {
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
    }
  }
</style>
