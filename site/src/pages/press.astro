---
// Doug's own press: shows, listings and write-ups of his playing as a leader
// and sideman, 2002 on. Data: src/data/doug-press.json, rendered by the same
// components as /easternblok/press and only while an entry is approved. Band
// press lives on /easternblok and /easternblok/press, so it isn't kept in two
// places. Out of draft 2026-10-23 once the page had real entries.
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import PressStrip from '../components/PressStrip.astro';
import PressWall from '../components/PressWall.astro';
import PressYears from '../components/PressYears.astro';
import dougPress from '../data/doug-press.json';
import bandPress from '../data/eastern-blok-press.json';
import { buildArchive, publicEntries } from '../data/press-archive.js';

const archive = buildArchive(dougPress.entries);
const bandCount = publicEntries(bandPress.entries).length;
const albums = [{ title: 'Better Than TV', year: 2014 }];
const reviewWord = archive.wall.length === 1 ? 'review' : 'reviews';
---

<ArchiveLayout
  title="Press — Doug Rosenberg"
  description={`Reviews, previews and listings of saxophonist Doug Rosenberg's own shows and recordings, ${archive.firstYear} to ${archive.lastYear}: Bob Moses, Keyon Harrold and Robert Glasper, and his quintet.`}
  eyebrow="Press"
  heading="On record"
  draft={false}
>
  <p slot="lead" class="archive__lead">
    {archive.total} pieces, {archive.firstYear} to {archive.lastYear}, about Doug Rosenberg's own playing: {archive.wall.length} {reviewWord}, a feature and previews, and the rest club and radio listings.
    Each links to the original.
  </p>

  <section class="archive__section" aria-labelledby="when">
    <h2 id="when">When it ran</h2>
    <PressStrip entries={archive.shown} albums={albums} start={archive.firstYear} end={archive.lastYear} />
    <p>
      Most of it is early. The Velvet Lounge, Chase Cafe, Jazz Record Mart and the Montage in Naperville fill 2002 to 2004, including shows with Keyon Harrold and Robert Glasper in May 2003 and with Bob Moses in April 2004.
    </p>
  </section>

  {archive.wall.length > 0 && (
    <section class="archive__section" aria-labelledby="reviews">
      <h2 id="reviews">Reviews</h2>
      <PressWall items={archive.wall} split={false} />
    </section>
  )}

  <section class="archive__section" aria-labelledby="everything-else">
    <h2 id="everything-else">Previews and listings, by year</h2>
    <p>
      Newspaper calendars, club and radio pages, and one retail listing for the CD. Club calendars show who played where and when;
      they aren't reviews. A few bill him as "Douglas" and are to be confirmed.
    </p>
    <PressYears years={archive.years} />
  </section>

  <section class="archive__section" aria-labelledby="band">
    <h2 id="band">With Eastern Blok</h2>
    <p>
      Most of the coverage of Doug's playing comes from the years with Eastern Blok, which began as the Goran Ivanovic Group. {bandCount} pieces are in
      the band's archive.
    </p>
    <a class="band-link" href="/easternblok/press" data-cta="press-to-easternblok">The Eastern Blok press</a>
  </section>

  <section class="archive__section" aria-labelledby="missing">
    <h2 id="missing">Still missing</h2>
    <p>
      Only one independent review of the CD, <cite>Better Than TV</cite>, has turned up so far; everything else announces it.
      If you wrote about a show or the record, or kept a clipping, <a href="/#contact">send it along</a>.
    </p>
  </section>
</ArchiveLayout>

<style>
  .band-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    text-underline-offset: 5px;
    text-decoration-color: var(--brass);
  }

  .band-link:hover,
  .band-link:focus-visible {
    color: var(--brass);
  }
</style>
