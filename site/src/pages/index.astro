---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TestPatternBar from '../components/TestPatternBar.astro';
import Listen from '../components/Listen.astro';
import About from '../components/About.astro';
import Performance from '../components/Performance.astro';
import Credibility from '../components/Credibility.astro';
import SheetMusicLibrary from '../components/SheetMusicLibrary.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="Doug Rosenberg — Saxophonist, Composer, Educator"
  description="Doug Rosenberg is a Chicago-based saxophonist, composer, and educator — jazz recordings, performances, and private instruction."
>
  <Hero />
  <TestPatternBar />
  <Listen />
  <About />
  <Performance />
  <Credibility />
  <SheetMusicLibrary />
  <Gallery />
  <Contact />
</BaseLayout>
