---
// Page-wide ambient glows (2026-11-14, Doug's ask: the plain charcoal
// background felt boring). A fixed layer behind the whole page, so the glows
// stay put in the viewport while the content scrolls over them. Same idea as
// the hero's left-side blobs in HeroGraded.astro, larger and fainter: slow
// drifts on uneven keyframe paths, each blob passing through the nav tones
// (hue-cycle, global.css) out of step with the others.
//
// Sections that used to paint an opaque --bg are transparent now so this
// shows through; the raised bands (About, Career Highlights) are 78% opaque.
// The hero photo and the footer stay opaque on purpose.
//
// Motion rules: the hero script sets data-fx="lite" on <html> for weak
// devices (still glows), and prefers-reduced-motion stills them too. A hidden
// tab is paused by the browser itself.
---

<div class="ambient" aria-hidden="true">
  <div class="ambient-blob ambient-blob--a"></div>
  <div class="ambient-blob ambient-blob--b"></div>
  <div class="ambient-blob ambient-blob--c"></div>
  <div class="ambient-blob ambient-blob--d"></div>
</div>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    --ambient-strength: 0.385; /* 0.5, then 0.25, then 0.35 on 2026-11-14, then +10% (0.385) on 2026-11-17 (Doug) */
    opacity: var(--ambient-strength);
  }

  /* Light theme (2026-11-21, Doug could not see the blobs on desktop): the same
     strength that glows on charcoal is a faint stain on paper, so the layer is
     stronger there. The light note colors are deep, so they read as ink washes. */
  :global(:root[data-theme='light']) .ambient {
    --ambient-strength: 0.95;
  }

  .ambient-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    background: radial-gradient(circle, color-mix(in srgb, var(--hue) 32%, transparent), transparent 68%);
  }

  /* sizes have a floor so they don't shrink to specks on a phone */
  .ambient-blob--a {
    width: max(46vw, 280px);
    height: max(46vw, 280px);
    top: -6%;
    left: -8%;
    --hue: var(--note-listen);
    animation: ambient-path-a 79s ease-in-out infinite;
  }

  .ambient-blob--b {
    width: max(40vw, 240px);
    height: max(40vw, 240px);
    top: 8%;
    right: -10%;
    --hue: var(--note-lessons);
    animation: ambient-path-b 67s ease-in-out infinite;
  }

  .ambient-blob--c {
    width: max(50vw, 300px);
    height: max(50vw, 300px);
    bottom: -12%;
    left: 14%;
    --hue: var(--note-highlights);
    animation: ambient-path-c 89s ease-in-out infinite;
  }

  .ambient-blob--d {
    width: max(36vw, 220px);
    height: max(36vw, 220px);
    bottom: 4%;
    right: 2%;
    --hue: var(--note-contact);
    animation: ambient-path-d 71s ease-in-out infinite;
  }

  /* Uneven stops; translations kept to roughly a third of the viewport so a
     blob wanders its own region instead of piling up with the others. */
  @keyframes ambient-path-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    18% { transform: translate(16vw, 14vh) scale(1.15); }
    43% { transform: translate(8vw, 38vh) scale(0.9); }
    66% { transform: translate(24vw, 22vh) scale(1.1); }
    84% { transform: translate(4vw, 8vh) scale(0.95); }
  }

  @keyframes ambient-path-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    21% { transform: translate(-18vw, 20vh) scale(1.2); }
    47% { transform: translate(-6vw, 44vh) scale(0.85); }
    69% { transform: translate(-22vw, 28vh) scale(1.05); }
    86% { transform: translate(-10vw, 6vh) scale(0.95); }
  }

  @keyframes ambient-path-c {
    0%, 100% { transform: translate(0, 0) scale(1); }
    16% { transform: translate(18vw, -16vh) scale(0.9); }
    39% { transform: translate(34vw, -34vh) scale(1.15); }
    62% { transform: translate(10vw, -22vh) scale(1); }
    81% { transform: translate(26vw, -6vh) scale(1.2); }
  }

  @keyframes ambient-path-d {
    0%, 100% { transform: translate(0, 0) scale(1); }
    24% { transform: translate(-14vw, -24vh) scale(1.2); }
    48% { transform: translate(-28vw, -10vh) scale(0.9); }
    72% { transform: translate(-8vw, -36vh) scale(1.1); }
    89% { transform: translate(-20vw, -18vh) scale(0.95); }
  }

  /* The color cycle only on a mouse-and-screen device (2026-11-19). Animating
     --hue repaints four large gradients every frame on the main thread: about
     17% of it, all the time, even when nothing was happening, which made a
     phone stutter (measured with the browser's own task timer, see
     docs/DESIGN_NOTES.md). The drift is `transform` (the individual translate
     and scale properties were main-thread work too), so it costs about
     nothing; touch devices keep the drift with each blob holding its own tone. */
  @media (hover: hover) and (pointer: fine) {
    .ambient-blob--a { animation: ambient-path-a 79s ease-in-out infinite, hue-cycle 91s linear infinite; }
    .ambient-blob--b { animation: ambient-path-b 67s ease-in-out infinite, hue-cycle 103s linear -41s infinite; }
    .ambient-blob--c { animation: ambient-path-c 89s ease-in-out infinite, hue-cycle 117s linear -83s infinite; }
    .ambient-blob--d { animation: ambient-path-d 71s ease-in-out infinite, hue-cycle 97s linear -19s infinite; }
  }

  /* Still on touch (2026-11-20): measured in Firefox, the four drifting
     gradient layers roughly doubled the time per scrolled frame (about 60ms
     against 28ms with them hidden), even as `transform`. A phone keeps the
     glow, held in place; a mouse-and-screen device keeps the drift. */
  @media (hover: none), (pointer: coarse) {
    .ambient .ambient-blob {
      animation: none;
    }
  }

  :global(:root[data-fx='lite']) .ambient-blob {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-blob {
      animation: none;
    }
  }
</style>
