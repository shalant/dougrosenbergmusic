---
// Page-wide ambient glows (2026-11-14, Doug's ask: the plain charcoal
// background felt boring). A fixed layer behind the whole page, so the glows
// stay put in the viewport while the content scrolls over them. Same idea as
// the hero's left-side blobs in HeroGraded.astro, larger and fainter: slow
// drifts on uneven keyframe paths, each blob passing through the nav tones
// (hue-cycle, global.css) out of step with the others.
//
// Sections that used to paint an opaque --bg are transparent now so this
// shows through; the raised bands (About, Career Highlights) are 78% opaque.
// The hero photo and the footer stay opaque on purpose.
//
// Motion rules: the hero script sets data-fx="lite" on <html> for weak
// devices (still glows), and prefers-reduced-motion stills them too. A hidden
// tab is paused by the browser itself.
---

<div class="ambient" aria-hidden="true">
  <div class="ambient-blob ambient-blob--a"></div>
  <div class="ambient-blob ambient-blob--b"></div>
  <div class="ambient-blob ambient-blob--c"></div>
  <div class="ambient-blob ambient-blob--d"></div>
</div>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    --ambient-strength: 0.35; /* 0.5, then 0.25, then 0.35 on 2026-11-14 (Doug) */
    opacity: var(--ambient-strength);
  }

  .ambient-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    background: radial-gradient(circle, color-mix(in srgb, var(--hue) 32%, transparent), transparent 68%);
  }

  /* sizes have a floor so they don't shrink to specks on a phone */
  .ambient-blob--a {
    width: max(46vw, 280px);
    height: max(46vw, 280px);
    top: -6%;
    left: -8%;
    animation:
      ambient-path-a 79s ease-in-out infinite,
      hue-cycle 91s linear infinite;
  }

  .ambient-blob--b {
    width: max(40vw, 240px);
    height: max(40vw, 240px);
    top: 8%;
    right: -10%;
    animation:
      ambient-path-b 67s ease-in-out infinite,
      hue-cycle 103s linear -41s infinite;
  }

  .ambient-blob--c {
    width: max(50vw, 300px);
    height: max(50vw, 300px);
    bottom: -12%;
    left: 14%;
    animation:
      ambient-path-c 89s ease-in-out infinite,
      hue-cycle 117s linear -83s infinite;
  }

  .ambient-blob--d {
    width: max(36vw, 220px);
    height: max(36vw, 220px);
    bottom: 4%;
    right: 2%;
    animation:
      ambient-path-d 71s ease-in-out infinite,
      hue-cycle 97s linear -19s infinite;
  }

  /* Uneven stops; translations kept to roughly a third of the viewport so a
     blob wanders its own region instead of piling up with the others. */
  @keyframes ambient-path-a {
    0%, 100% { translate: 0 0; scale: 1; }
    18% { translate: 16vw 14vh; scale: 1.15; }
    43% { translate: 8vw 38vh; scale: 0.9; }
    66% { translate: 24vw 22vh; scale: 1.1; }
    84% { translate: 4vw 8vh; scale: 0.95; }
  }

  @keyframes ambient-path-b {
    0%, 100% { translate: 0 0; scale: 1; }
    21% { translate: -18vw 20vh; scale: 1.2; }
    47% { translate: -6vw 44vh; scale: 0.85; }
    69% { translate: -22vw 28vh; scale: 1.05; }
    86% { translate: -10vw 6vh; scale: 0.95; }
  }

  @keyframes ambient-path-c {
    0%, 100% { translate: 0 0; scale: 1; }
    16% { translate: 18vw -16vh; scale: 0.9; }
    39% { translate: 34vw -34vh; scale: 1.15; }
    62% { translate: 10vw -22vh; scale: 1; }
    81% { translate: 26vw -6vh; scale: 1.2; }
  }

  @keyframes ambient-path-d {
    0%, 100% { translate: 0 0; scale: 1; }
    24% { translate: -14vw -24vh; scale: 1.2; }
    48% { translate: -28vw -10vh; scale: 0.9; }
    72% { translate: -8vw -36vh; scale: 1.1; }
    89% { translate: -20vw -18vh; scale: 0.95; }
  }

  :global(:root[data-fx='lite']) .ambient-blob {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-blob {
      animation: none;
    }
  }
</style>
