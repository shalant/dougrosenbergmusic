---

<section id="sheet-music" class="sheet-music staff-lines">
  <div class="wrap">
    <h2 class="sheet-music__heading">Sheet Music Library</h2>
    <p class="sheet-music__sub">Practice pieces and lesson material for private students — search or browse, then open a piece to view.</p>

    <div class="sheet-music__panel">
      <div class="sheet-music__list-col">
        <input class="sheet-music__search" type="text" placeholder="Search pieces…" data-sheet-search aria-label="Search sheet music" />
        <ul class="sheet-music__list" data-sheet-list>
          {pieces.map((p, i) => (
            <li>
              <button class="sheet-music__item" data-file={p.file} data-type={p.type} data-title={p.title} data-index={i}>
                {p.title}
              </button>
            </li>
          ))}
          <li class="sheet-music__none" data-sheet-none hidden>
            No piece matches “<span data-sheet-none-query></span>”. Try a word from the title, or clear the search.
          </li>
        </ul>
      </div>

      <div class="sheet-music__viewer">
        <div class="sheet-music__viewer-empty" data-viewer-empty>
          <p class="sheet-music__viewer-empty-text">
            <span class="sheet-music__viewer-empty-icon" aria-hidden="true">&#9835;</span>
            <span class="label">{pieces.length} pieces.</span> Pick one and it opens here.
          </p>
        </div>
        <div class="sheet-music__viewer-active" data-viewer-active hidden>
          <div class="sheet-music__viewer-head">
            <h3 data-viewer-title></h3>
            <a data-viewer-link href="#" target="_blank" rel="noopener noreferrer">Open in new tab →</a>
          </div>
          <iframe data-viewer-frame class="sheet-music__frame" title="Sheet music preview" hidden></iframe>
          <img data-viewer-image class="sheet-music__frame sheet-music__frame--image" alt="" hidden />
          <p class="sheet-music__error" data-viewer-error role="status" hidden>
            That page didn’t load. Try “Open in new tab”, or check your connection.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sheet-music {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--bg);
  }

  .sheet-music__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 0.6rem;
  }

  .sheet-music__sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 58ch;
    margin: 0 0 2.5rem;
  }

  .sheet-music__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr);
    /* One row sized to the card, so the list and the viewer both stretch to
       its full height (was: the list capped at 420px and the viewer at a
       420px floor, leaving the card about 60% filled on a tall screen). The
       card follows the window height with a floor that fits the search box
       plus a few rows, and a ceiling so it doesn't stretch past a PDF page. */
    grid-template-rows: minmax(0, 1fr);
    height: clamp(560px, 85vh, 860px);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--surface);
    border: 1px solid rgba(233, 237, 245, 0.08);
    border-radius: 10px;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .sheet-music__list-col {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .sheet-music__search {
    flex: none;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid rgba(233, 237, 245, 0.14);
    border-radius: 6px;
    /* padding-block bumped (0.6rem -> 0.85rem) to clear the 44px touch-
       target minimum - measured 37px before, confirmed via getBoundingClientRect
       in a real headless run, not assumed. */
    padding: 0.85rem 0.8rem;
    margin-bottom: 0.9rem;
    transition: border-color var(--dur-base) ease;
  }

  @media (hover: hover) {
    .sheet-music__search:hover {
      border-color: rgba(233, 237, 245, 0.3);
    }
  }

  /* Same focus treatment as the contact form's fields: a brass border plus a
     soft ring, so focus isn't carried by a 1px color change alone. */
  .sheet-music__search:focus {
    outline: none;
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.14);
  }

  .sheet-music__list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .sheet-music__item {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.86rem;
    padding: 0.9rem 0.6rem;
    border-radius: 5px;
    cursor: pointer;
  }

  .sheet-music__item:hover,
  .sheet-music__item:focus-visible {
    background: var(--staff-line);
    color: var(--text);
  }

  .sheet-music__item.is-active {
    background: var(--brass-soft);
    color: var(--text);
  }

  /* Feedback on press and a clearer "this one is open" marker
     (2026-10-17): a brass bar grows in on the active row's left edge. */
  .sheet-music__item {
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease, box-shadow var(--dur-base) ease, scale var(--dur-fast) ease;
  }

  .sheet-music__item:active {
    scale: 0.985;
  }

  .sheet-music__item.is-active {
    box-shadow: inset 3px 0 0 var(--brass);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-music__item {
      transition: none;
    }
    .sheet-music__item:active {
      scale: none;
    }
  }

  .sheet-music__item[hidden] {
    display: none;
  }

  /* The edge states (2026-10-31): a search with no hits used to leave a blank
     list, and an image that failed to load left an empty frame. */
  .sheet-music__none,
  .sheet-music__error {
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.5;
    padding: 0.9rem 0.6rem;
    margin: 0;
  }

  .sheet-music__none[hidden],
  .sheet-music__error[hidden] {
    display: none;
  }

  .sheet-music__viewer {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .sheet-music__viewer-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    border: 1px solid rgba(233, 237, 245, 0.1);
    border-radius: 8px;
    /* Blank manuscript paper (2026-10-25): five-line staves ruled down the
       panel, so the empty viewer reads as a page waiting for a piece rather
       than half a card of nothing. Loading a piece by default was ruled out:
       the first one is a 4.6MB PDF. Earlier versions: a dashed wireframe box,
       then a brass glow behind a note glyph. */
    background-color: var(--surface);
    background-image: repeating-linear-gradient(
      180deg,
      var(--staff-line-strong) 0 1px, transparent 1px 9px,
      var(--staff-line-strong) 9px 10px, transparent 10px 18px,
      var(--staff-line-strong) 18px 19px, transparent 19px 27px,
      var(--staff-line-strong) 27px 28px, transparent 28px 36px,
      var(--staff-line-strong) 36px 37px, transparent 37px 76px
    );
    background-size: calc(100% - 3rem) 76px;
    background-position: center 1.5rem;
    background-repeat: repeat-y;
  }

  /* The prompt sits on a solid patch so the staff lines don't run through
     its text. */
  .sheet-music__viewer-empty-text {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.6rem 1.1rem;
    background: var(--surface);
    border-radius: 6px;
  }

  .sheet-music__viewer-empty-icon {
    font-size: 1.6rem;
    line-height: 1;
    color: var(--brass);
  }

  .sheet-music__viewer-empty[hidden] {
    display: none;
  }

  .sheet-music__viewer-active {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .sheet-music__viewer-active[hidden] {
    display: none;
  }

  .sheet-music__viewer-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .sheet-music__viewer-head h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0;
  }

  .sheet-music__viewer-head a {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brass);
    text-decoration: none;
    white-space: nowrap;
    /* Symmetric padding-block only - grows the real click/tap target to
       44px without shifting the visible text, since the row's own
       align-items: baseline keeps the glyph position fixed regardless. */
    padding-block: 0.85rem;
    margin-block: -0.85rem;
  }

  .sheet-music__viewer-head a:hover {
    text-decoration: underline;
  }

  .sheet-music__frame {
    flex: 1;
    width: 100%;
    min-height: 0;
    border: 1px solid rgba(233, 237, 245, 0.1);
    border-radius: 6px;
    background: #fff;
  }

  /* A global `img { display: block }` outranks the browser's [hidden] rule, so
     the unused <img> kept its flex share and halved the PDF frame. */
  .sheet-music__frame[hidden] {
    display: none;
  }

  .sheet-music__frame--image {
    object-fit: contain;
    background: var(--bg);
  }

  @media (max-width: 800px) {
    /* Stacked on mobile the card grows with its content instead of filling a
       viewport-sized height: a fixed-height card would leave the list and the
       viewer fighting over it. The list keeps its own scroll cap, the empty
       viewer a small floor (a taller one reserved a mostly-empty box just for
       "select a piece to view", confirmed via a real mobile screenshot), and
       the open PDF frame a floor tall enough to read. */
    .sheet-music__panel {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
    }
    .sheet-music__list {
      flex: none;
      max-height: 260px;
    }
    .sheet-music__viewer {
      min-height: 180px;
    }
    .sheet-music__frame {
      min-height: 380px;
    }
  }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-sheet-search]');
  const list = document.querySelector<HTMLElement>('[data-sheet-list]');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.sheet-music__item'));
  const viewerEmpty = document.querySelector<HTMLElement>('[data-viewer-empty]');
  const viewerActive = document.querySelector<HTMLElement>('[data-viewer-active]');
  const viewerTitle = document.querySelector<HTMLElement>('[data-viewer-title]');
  const viewerLink = document.querySelector<HTMLAnchorElement>('[data-viewer-link]');
  const viewerFrame = document.querySelector<HTMLIFrameElement>('[data-viewer-frame]');
  const viewerImage = document.querySelector<HTMLImageElement>('[data-viewer-image]');
  const none = document.querySelector<HTMLElement>('[data-sheet-none]');
  const noneQuery = document.querySelector<HTMLElement>('[data-sheet-none-query]');
  const viewerError = document.querySelector<HTMLElement>('[data-viewer-error]');

  if (search && list && viewerEmpty && viewerActive && viewerTitle && viewerLink && viewerFrame && viewerImage && none && noneQuery && viewerError) {
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((item) => {
        const match = item.dataset.title?.toLowerCase().includes(q);
        item.hidden = !match;
        if (match) shown++;
      });
      noneQuery.textContent = search.value.trim();
      none.hidden = shown > 0;
    });

    items.forEach((item) => {
      item.addEventListener('click', () => {
        items.forEach((i) => i.classList.remove('is-active'));
        item.classList.add('is-active');

        const file = item.dataset.file ?? '';
        const type = item.dataset.type;
        const url = `${import.meta.env.BASE_URL}sheetmusic/${file}`;

        viewerEmpty.hidden = true;
        viewerActive.hidden = false;
        viewerError.hidden = true;
        viewerTitle.textContent = item.dataset.title ?? '';
        viewerLink.href = url;

        if (type === 'image') {
          viewerFrame.hidden = true;
          viewerFrame.src = '';
          viewerImage.hidden = false;
          viewerImage.src = url;
          viewerImage.alt = item.dataset.title ?? '';
        } else {
          viewerImage.hidden = true;
          viewerImage.src = '';
          viewerFrame.hidden = false;
          viewerFrame.src = url;
        }
      });
    });

    viewerImage.addEventListener('error', () => {
      // an emptied src (switching to a PDF) also fires error; only a real URL counts
      if (viewerImage.getAttribute('src')) {
        viewerImage.hidden = true;
        viewerError.hidden = false;
      }
    });

    viewerLink.addEventListener('click', () => {
      // Same best-effort/try-catch pattern as BaseLayout's cta_click listener:
      // a blocked or missing gtag must never break the actual file link.
      try {
        (window as any).gtag?.('event', 'sheet_music_download', {
          piece_title: viewerTitle.textContent ?? '',
          file_name: viewerLink.href.split('/').pop() ?? '',
        });
      } catch {}
    });
  }
</script>
