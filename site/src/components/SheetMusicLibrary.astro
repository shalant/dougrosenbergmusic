  { title: 'Diverse — Charlie Parker', file: 'diverse-charlie-parker.pdf', type: 'pdf' },
  { title: 'Fantasy Piece — Schumann', file: 'fantasy-piece-schumann.pdf', type: 'pdf' },
  { title: 'Fur Elise', file: 'fur-elise.pdf', type: 'pdf' },
