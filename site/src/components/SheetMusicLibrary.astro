  { title: 'In the Hall of the Mountain King', file: 'in-the-hall-of-the-mountain-king.pdf', type: 'pdf' },
  { title: 'Mis Amores — Cervantes', file: 'mis-amores-cervantes.pdf', type: 'pdf' },
  { title: 'Music Theory Quiz (Aebersold)', file: 'music-theory-quiz-aebersold.pdf', type: 'pdf' },
