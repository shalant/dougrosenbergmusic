  { title: 'Adagio and Allegro by Handel', file: 'adagio-and-allegro-handel.pdf', type: 'pdf' },
  { title: 'Aebersold Track 6', file: 'aebersold-track-6.png', type: 'image' },
  { title: 'Alegretto by Arensky', file: 'alegretto-arensky.pdf', type: 'pdf' },
  { title: 'Arioso by Bach', file: 'arioso-bach.pdf', type: 'pdf' },
  { title: 'Arioso Sinfonia by Bach', file: 'arioso-sinfonia-bach.pdf', type: 'pdf' },
  { title: 'Prelude by Bach, page 2', file: 'bach-prelude-page2.pdf', type: 'pdf' },
  { title: 'Prelude by Bach', file: 'bach-prelude.pdf', type: 'pdf' },
  { title: "Billie's Bounce in Bb", file: 'billies-bounce-bb.pdf', type: 'pdf' },
  { title: 'Chanson de Printemps, page 2', file: 'chanson-de-printemps-page2.png', type: 'image' },
  { title: 'Concertino by Guildhaud', file: 'concertino-guildhaud.pdf', type: 'pdf' },
  { title: 'Corn Bread Bb', file: 'corn-bread-bb.pdf', type: 'pdf' },
