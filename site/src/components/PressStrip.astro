---
// A staff-line timeline of the coverage (the page picks the years): one tick per dated piece,
// tall and brass for reviews and features, short for everything else, with
// any album releases marked underneath. Decorative (aria-hidden); the
// page's summary sentence carries the same facts in text. Ticks are placed
// by tickPosition() in src/data/press-archive.js.
import { sortDate, tickPosition, wallQuote } from '../data/press-archive.js';

interface Props {
  entries: any[];
  albums: { title: string; year: number }[];
  start: number;
  end: number;
}

const { entries, albums, start: START, end: END } = Astro.props;

const ticks = entries
  .map((entry) => ({ at: tickPosition(sortDate(entry), START, END), review: wallQuote(entry) !== null }))
  .filter((tick): tick is { at: number; review: boolean } => tick.at !== null)
  .sort((a, b) => Number(a.review) - Number(b.review));

const years = Array.from({ length: END - START + 1 }, (_, i) => START + i);
const pct = (fraction: number) => `${(fraction * 100).toFixed(2)}%`;
const flags = albums
  .filter((album) => album.year >= START && album.year <= END)
  .map((album) => ({ title: album.title, year: album.year, at: ((album.year - START) * 12 + 6) / ((END - START + 1) * 12) }));
// A label is wider than the gap between consecutive years (at 390px "Goran Ivanovic Group" and
// "Folk Tales", a year apart, printed over each other), so a label whose year is within a year of
// the one before it drops to a second row. The strip grows by one row only when that happens.
const rows: number[] = [];
flags.forEach((flag, i) => rows.push(i > 0 && flag.year - flags[i - 1].year <= 1 && rows[i - 1] === 0 ? 1 : 0));
const extra = rows.includes(1) ? '1.9rem' : '0rem';
---

<div class="strip" style={`--extra:${extra}`} aria-hidden="true">
  <div class="strip__ticks">
    {ticks.map((tick) => <span class={`tick${tick.review ? ' tick--review' : ''}`} style={`left:${pct(tick.at)}`}></span>)}
  </div>
  <div class="strip__axis">
    {years.map((year) => <span class="strip__year" style={`left:${pct((year - START) / years.length)}`}>{year}</span>)}
  </div>
  <div class="strip__albums">
    {flags.map((flag, i) => <span class="strip__album" style={`left:${pct(flag.at)};top:${rows[i] * 1.9}rem`}>{flag.title}</span>)}
  </div>
</div>

<style>
  .strip {
    position: relative;
    height: calc(12rem + var(--extra, 0rem));
    margin-inline: 0.5rem;
  }

  .strip__ticks {
    position: absolute;
    inset: 0 0 calc(4rem + var(--extra, 0rem));
    border-bottom: 2px solid var(--brass);
    /* four more staff lines above the baseline, 14px apart */
    background-image: repeating-linear-gradient(
      to top,
      transparent 0,
      transparent 13px,
      var(--staff-line-strong) 13px,
      var(--staff-line-strong) 14px
    );
    background-size: 100% 57px;
    background-position: bottom;
    background-repeat: no-repeat;
  }

  .tick {
    position: absolute;
    bottom: 0;
    width: 3px;
    height: 1.5rem;
    margin-left: -1.5px;
    background: var(--brass);
    opacity: 0.55;
  }

  .tick--review {
    height: 6rem;
    opacity: 1;
    box-shadow: 0 0 10px rgba(207, 154, 79, 0.55);
  }

  /* A year is 1/10 of the width; labels sit at the start of their year. */
  .strip__axis {
    position: absolute;
    inset: auto 0 calc(2.1rem + var(--extra, 0rem));
    height: 1.2rem;
  }

  .strip__year {
    position: absolute;
    top: 0.35rem;
    padding-left: 0.3rem;
    border-left: 1px solid var(--staff-line-strong);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .strip__albums {
    position: absolute;
    inset: auto 0 0;
    height: calc(1.6rem + var(--extra, 0rem));
  }

  .strip__album {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--brass);
  }

  @media (max-width: 700px) {
    .strip__year:nth-child(even) {
      visibility: hidden;
    }

    .strip__album {
      font-size: 0.85rem;
    }
  }
</style>
