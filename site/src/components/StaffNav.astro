---
// Feather-style line icons (24x24, stroke=currentColor) - matches the thin
// stroke look already used for the hero's scroll-cue chevron.
const ICONS: Record<string, string> = {
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="m8.5 13.5-1.5 8 5-3 5 3-1.5-8"/>',
  mail: '<path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="m3 6 9 7 9-7"/>',
};

// hero/"Home" dropped as of the Logo component's top-left home link -
// StaffNav no longer needs its own note for it.
const sections = [
  { id: 'listen', label: 'Listen', icon: 'music', tone: 'listen', left: 40, top: 50 },
  { id: 'about', label: 'About', icon: 'user', tone: 'about', left: 116, top: 50 },
  { id: 'credibility', label: 'Highlights', icon: 'award', tone: 'cred', left: 192, top: 50 },
  { id: 'contact', label: 'Contact', icon: 'mail', tone: 'contact', left: 268, top: 50 },
];

const devLink = { label: 'Dev', abbr: 'DEV', tone: 'dev', href: 'https://dougrosenbergdev.com', left: 344, top: 50 };
---

<nav class="staff-nav" aria-label="Section navigation" data-staff-nav>
  <div class="staff-nav__line" style="top: 26px;"></div>
  <div class="staff-nav__line" style="top: 38px;"></div>
  <div class="staff-nav__line" style="top: 50px;"></div>
  <div class="staff-nav__line" style="top: 62px;"></div>
  <div class="staff-nav__line" style="top: 74px;"></div>

  {sections.map((s) => (
    <button
      class={`staff-nav__note note--${s.tone} staff-jump`}
      data-target={s.id}
      style={`left: ${s.left}px; top: ${s.top}px;`}
      aria-label={s.label}
    >
      <span class="staff-nav__blob" aria-hidden="true">
        <svg class="staff-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} />
      </span>
      <span class="staff-nav__tag">{s.label}</span>
    </button>
  ))}

  <a
    class={`staff-nav__note note--${devLink.tone}`}
    href={devLink.href}
    style={`left: ${devLink.left}px; top: ${devLink.top}px;`}
    aria-label={devLink.label}
  >
    <span class="staff-nav__blob" aria-hidden="true">{devLink.abbr}</span>
    <span class="staff-nav__tag">{devLink.label}</span>
  </a>
</nav>

<button
  class="staff-toggle"
  data-menu-toggle
  aria-label="Open section menu"
  aria-expanded="false"
  aria-controls="staff-menu-panel"
>
  <span class="staff-toggle__bar"></span>
  <span class="staff-toggle__bar"></span>
  <span class="staff-toggle__bar"></span>
</button>

<div class="staff-menu" id="staff-menu-panel" data-menu-panel hidden>
  <ul class="staff-menu__list">
    {sections.map((s) => (
      <li>
        <button
          class={`staff-menu__item note--${s.tone} staff-jump`}
          data-target={s.id}
        >
          <span class="staff-menu__dot" aria-hidden="true"></span>
          <span class="staff-menu__label">{s.label}</span>
        </button>
      </li>
    ))}
    <li>
      <a class={`staff-menu__item note--${devLink.tone}`} href={devLink.href}>
        <span class="staff-menu__dot" aria-hidden="true"></span>
        <span class="staff-menu__label">{devLink.label}</span>
      </a>
    </li>
  </ul>
</div>

<style>
  .staff-nav {
    position: fixed;
    top: 12px;
    right: 20px;
    width: 380px;
    height: 100px;
    z-index: 40;
    background: rgba(19, 26, 38, 0.38);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-radius: 28px;
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.45);
  }

  .staff-nav__line {
    position: absolute;
    left: 20px;
    right: 20px;
    height: 1px;
    background: var(--staff-line-strong);
  }

  .staff-nav__note {
    position: absolute;
    margin: -24px 0 0 -28px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    text-decoration: none;
    color: inherit;
  }

  .staff-nav__blob {
    width: 56px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--bg);
    box-shadow: 0 4px 20px -8px rgba(0, 0, 0, 0.6);
    opacity: 0.5;
    transition: opacity 0.3s ease, filter 0.2s ease;
    animation: staff-breathe 4.6s ease-in-out infinite;
  }

  .staff-nav__icon {
    width: 22px;
    height: 22px;
  }

  .staff-nav__note:hover .staff-nav__blob,
  .staff-nav__note:focus-visible .staff-nav__blob {
    filter: brightness(1.18);
  }

  .staff-nav__note:focus-visible {
    outline: none;
  }

  .staff-nav__note:focus-visible .staff-nav__blob {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6), 0 4px 20px -8px rgba(0, 0, 0, 0.6);
  }

  @keyframes staff-breathe {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.1) rotate(3deg); }
  }

  .staff-nav__note.note--hero .staff-nav__blob,
  .staff-menu__item.note--hero .staff-menu__dot { background: var(--note-hero); }
  .staff-nav__note.note--listen .staff-nav__blob,
  .staff-menu__item.note--listen .staff-menu__dot { background: var(--note-listen); }
  .staff-nav__note.note--about .staff-nav__blob,
  .staff-menu__item.note--about .staff-menu__dot { background: var(--note-about); }
  .staff-nav__note.note--cred .staff-nav__blob,
  .staff-menu__item.note--cred .staff-menu__dot { background: var(--note-cred); }
  .staff-nav__note.note--contact .staff-nav__blob,
  .staff-menu__item.note--contact .staff-menu__dot { background: var(--note-contact); }
  .staff-nav__note.note--dev .staff-nav__blob,
  .staff-menu__item.note--dev .staff-menu__dot { background: var(--note-dev); }

  .staff-nav__note.note--hero .staff-nav__blob { border-radius: 58% 42% 63% 37% / 41% 55% 45% 59%; animation-delay: 0s; }
  .staff-nav__note.note--listen .staff-nav__blob { border-radius: 42% 58% 37% 63% / 60% 38% 62% 40%; animation-delay: 0.9s; }
  .staff-nav__note.note--about .staff-nav__blob { border-radius: 65% 35% 45% 55% / 48% 62% 38% 52%; animation-delay: 1.8s; }
  .staff-nav__note.note--cred .staff-nav__blob { border-radius: 38% 62% 55% 45% / 55% 45% 62% 38%; animation-delay: 2.7s; }
  .staff-nav__note.note--contact .staff-nav__blob { border-radius: 60% 40% 40% 60% / 35% 60% 40% 65%; animation-delay: 3.6s; }
  .staff-nav__note.note--dev .staff-nav__blob { border-radius: 50% 50% 55% 45% / 45% 55% 50% 50%; animation-delay: 4.5s; }

  .staff-nav__tag {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid rgba(233, 237, 245, 0.1);
    padding: 0.32rem 0.75rem;
    border-radius: 5px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .staff-nav__note:hover .staff-nav__tag,
  .staff-nav__note:focus-visible .staff-nav__tag {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .staff-nav__note:not(.is-active) .staff-nav__blob {
    opacity: 0.5;
  }

  @keyframes breathe-active {
    0%, 100% { transform: scale(1.05); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.22), 0 2px 10px -4px rgba(0, 0, 0, 0.6); }
    50% { transform: scale(1.15); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0), 0 2px 10px -4px rgba(0, 0, 0, 0.6); }
  }

  .staff-nav__note.is-active .staff-nav__blob {
    animation: breathe-active 2.2s ease-in-out infinite;
    opacity: 1;
  }

  /* the active note's own pulse animation continuously redeclares box-shadow
     every frame, which silently overrides the focus-visible ring below it in
     the cascade - pause the pulse while focused so the ring stays visible */
  .staff-nav__note.is-active:focus-visible .staff-nav__blob {
    animation: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6), 0 4px 20px -8px rgba(0, 0, 0, 0.6);
  }

  /* Desktop staff hides below this width; the hamburger below picks up from here. */
  @media (max-width: 860px) {
    .staff-nav {
      display: none;
    }
  }

  /* The nav's fixed 456px width eats a much bigger share of narrower desktop
     widths just above the hamburger breakpoint - without this, it lands on
     top of the hero photo's subject instead of the empty sky beside them
     (confirmed via real screenshots at 861px, not assumed). Scaling down
     from the same fixed top-right corner keeps every note's relative
     spacing intact - no need to touch the per-note pixel offsets above. */
  @media (min-width: 861px) and (max-width: 1010px) {
    .staff-nav {
      transform-origin: top right;
      transform: scale(0.74);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .staff-nav__blob {
      animation: none !important;
    }
  }

  /* ---- mobile: hamburger + dropdown, same four notes; Logo.astro sits top-left independently ---- */

  .staff-toggle {
    display: none;
    position: fixed;
    top: 12px;
    right: 20px;
    z-index: 41;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    background: rgba(10, 14, 23, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(233, 237, 245, 0.12);
    border-radius: 999px;
    cursor: pointer;
  }

  .staff-toggle__bar {
    width: 18px;
    height: 2px;
    background: var(--brass);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .staff-toggle.is-open .staff-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .staff-toggle.is-open .staff-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .staff-toggle.is-open .staff-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .staff-menu {
    display: none;
    position: fixed;
    top: 64px;
    right: 20px;
    z-index: 41;
    width: min(240px, calc(100vw - 40px));
    background: var(--bg-elevated);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(233, 237, 245, 0.1);
    border-radius: 14px;
    padding: 0.4rem;
    box-shadow: 0 20px 45px -20px rgba(0, 0, 0, 0.7);
  }

  .staff-menu[hidden] {
    display: none;
  }

  .staff-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .staff-menu__item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: none;
    border: none;
    padding: 0.65rem 0.7rem;
    border-radius: 9px;
    cursor: pointer;
    font: inherit;
    text-align: left;
    text-decoration: none;
    color: inherit;
  }

  .staff-menu__item:hover,
  .staff-menu__item:focus-visible {
    background: var(--staff-line);
  }

  .staff-menu__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .staff-menu__item.is-active .staff-menu__dot {
    opacity: 1;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.14);
  }

  .staff-menu__label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .staff-menu__item.is-active .staff-menu__label {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .staff-toggle {
      display: flex;
    }
    .staff-menu:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const sectionIds = ['listen', 'about', 'credibility', 'contact'];
  const jumpButtons = Array.from(document.querySelectorAll<HTMLElement>('.staff-jump'));

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  function closeMenu() {
    panel?.setAttribute('hidden', '');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.classList.remove('is-open');
  }

  function openMenu() {
    panel?.removeAttribute('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.classList.add('is-open');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  document.addEventListener('click', (e) => {
    if (!panel || panel.hasAttribute('hidden')) return;
    const target = e.target as Node;
    if (panel.contains(target) || toggle?.contains(target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  jumpButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      // Logo.astro's home link is a real `<a href="#hero">` (works without JS,
      // matches id="hero"); prevented here so its target section is reached
      // by the same smooth-scroll every other nav item uses, rather than a
      // native hash jump that would leave a stale #hero in the URL forever
      // once the user scrolls elsewhere (nothing else in this nav touches
      // the URL either).
      e.preventDefault();
      const target = document.getElementById(btn.dataset.target ?? '');
      target?.scrollIntoView({ behavior: 'smooth' });
      closeMenu();
    });
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          jumpButtons.forEach((btn) => {
            btn.classList.toggle('is-active', btn.dataset.target === entry.target.id);
          });
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
