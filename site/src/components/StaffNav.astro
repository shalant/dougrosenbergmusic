---
// Feather-style line icons (24x24, stroke=currentColor) - matches the thin
// stroke look already used for the hero's scroll-cue chevron.
const ICONS: Record<string, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="m8.5 13.5-1.5 8 5-3 5 3-1.5-8"/>',
  book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  mail: '<path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="m3 6 9 7 9-7"/>',
};

// hero/"Home" dropped as of the Logo component's top-left home link -
// StaffNav no longer needs its own note for it.
//
// "dev" used to be a standalone `<a>` straight out to dougrosenbergdev.com,
// styled differently from the rest of this list. Promoted to a real tracked
// section (own scroll-active state, same staff-jump behavior as the others)
// once a dedicated #dev section existed on the page to jump to - the pill's
// job changed from "leave the site" to "jump to the pitch," so it belongs
// in this list now, positioned first to match where #dev actually sits in
// the page (right after the hero).
const sections = [
  { id: 'listen', label: 'Listen', icon: 'music', tone: 'listen', left: 40, top: 50 },
  { id: 'about', label: 'About', icon: 'user', tone: 'about', left: 116, top: 50 },
  { id: 'career-highlights', label: 'Highlights', icon: 'award', tone: 'highlights', left: 192, top: 50 },
  { id: 'lessons', label: 'Lessons', icon: 'book', tone: 'lessons', left: 268, top: 50 },
  { id: 'dev', label: 'Dev', icon: 'code', tone: 'dev', left: 344, top: 50 },
  { id: 'contact', label: 'Contact', icon: 'mail', tone: 'contact', left: 420, top: 50 },
];
---

<nav class="staff-nav" aria-label="Section navigation" data-staff-nav>
  <div class="staff-nav__line" style="top: 26px;"></div>
  <div class="staff-nav__line" style="top: 38px;"></div>
  <div class="staff-nav__line" style="top: 50px;"></div>
  <div class="staff-nav__line" style="top: 62px;"></div>
  <div class="staff-nav__line" style="top: 74px;"></div>

  {sections.map((s) => (
    <button
      class={`staff-nav__note note--${s.tone} staff-jump`}
      data-target={s.id}
      style={`left: ${s.left}px; top: ${s.top}px;`}
      aria-label={s.label}
    >
      <span class="staff-nav__blob" aria-hidden="true">
        <svg class="staff-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} />
      </span>
      <span class="staff-nav__tag">{s.label}</span>
    </button>
  ))}
</nav>

<button
  class="staff-toggle"
  data-menu-toggle
  aria-label="Open section menu"
  aria-expanded="false"
  aria-controls="staff-menu-panel"
>
  <span class="staff-toggle__bar"></span>
  <span class="staff-toggle__bar"></span>
  <span class="staff-toggle__bar"></span>
</button>

<div class="staff-menu" id="staff-menu-panel" data-menu-panel aria-hidden="true">
  <div class="staff-menu__inner">
    <div class="staff-menu__staff" aria-hidden="true">
      <div class="staff-menu__rule" style="left: 0;"></div>
      <div class="staff-menu__rule" style="left: 11px;"></div>
      <div class="staff-menu__rule" style="left: 22px;"></div>
      <div class="staff-menu__rule" style="left: 33px;"></div>
      <div class="staff-menu__rule" style="left: 44px;"></div>
    </div>
    <ul class="staff-menu__list">
      {sections.map((s) => (
        <li>
          <button
            class={`staff-menu__item note--${s.tone} staff-jump`}
            data-target={s.id}
          >
            <span class="staff-menu__dot" aria-hidden="true">
              <svg class="staff-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} />
            </span>
            <span class="staff-menu__label">{s.label}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Glass-blur translucent panel, by request - accepted tradeoff is that
     body text/images scrolling underneath show through it (previously
     reverted to a solid --bg-elevated background over this exact issue,
     confirmed via screenshots of the About pull-quote, the "Professional
     Affiliations" heading, and a Gallery photo bleeding through). */
  .staff-nav {
    position: fixed;
    top: 12px;
    right: 20px;
    width: 456px;
    height: 100px;
    z-index: 40;
    background: rgba(10, 14, 23, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(233, 237, 245, 0.12);
    border-radius: 28px;
    box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.6);
  }

  .staff-nav__line {
    position: absolute;
    left: 20px;
    right: 20px;
    height: 1px;
    background: var(--staff-line-strong);
  }

  .staff-nav__note {
    position: absolute;
    margin: -24px 0 0 -28px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    text-decoration: none;
    color: inherit;
  }

  .staff-nav__blob {
    width: 56px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--bg);
    box-shadow: 0 4px 20px -8px rgba(0, 0, 0, 0.6);
    opacity: 0.5;
    /* No idle loop since 2026-10-17: all seven notes used to breathe
       forever, on every screen (the nav is fixed), which drowned out the
       one pulse that means something - the active note below. Now the
       others sit still and answer the pointer instead. scale/rotate are
       separate properties so they stack on the active pulse's transform. */
    transition: opacity var(--dur-med) ease, filter var(--dur-base) ease, scale var(--dur-med) var(--ease-spring), rotate var(--dur-med) var(--ease-spring);
  }

  .staff-nav__icon {
    width: 22px;
    height: 22px;
  }

  .staff-nav__note:hover .staff-nav__blob,
  .staff-nav__note:focus-visible .staff-nav__blob {
    filter: brightness(1.18);
  }

  .staff-nav__note:focus-visible .staff-nav__blob {
    scale: 1.1;
    rotate: -4deg;
  }

  @media (hover: hover) {
    .staff-nav__note:hover .staff-nav__blob {
      scale: 1.1;
      rotate: -4deg;
    }
  }

  .staff-nav__note:focus-visible {
    outline: none;
  }

  .staff-nav__note:focus-visible .staff-nav__blob {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6), 0 4px 20px -8px rgba(0, 0, 0, 0.6);
  }

  .staff-nav__note.note--hero .staff-nav__blob,
  .staff-menu__item.note--hero .staff-menu__dot { background: var(--note-hero); }
  .staff-nav__note.note--listen .staff-nav__blob,
  .staff-menu__item.note--listen .staff-menu__dot { background: var(--note-listen); }
  .staff-nav__note.note--about .staff-nav__blob,
  .staff-menu__item.note--about .staff-menu__dot { background: var(--note-about); }
  .staff-nav__note.note--highlights .staff-nav__blob,
  .staff-menu__item.note--highlights .staff-menu__dot { background: var(--note-highlights); }
  .staff-nav__note.note--lessons .staff-nav__blob,
  .staff-menu__item.note--lessons .staff-menu__dot { background: var(--note-lessons); }
  .staff-nav__note.note--contact .staff-nav__blob,
  .staff-menu__item.note--contact .staff-menu__dot { background: var(--note-contact); }
  .staff-nav__note.note--dev .staff-nav__blob,
  .staff-menu__item.note--dev .staff-menu__dot { background: var(--note-dev); }

  .staff-nav__note.note--hero .staff-nav__blob { border-radius: 58% 42% 63% 37% / 41% 55% 45% 59%; }
  .staff-nav__note.note--listen .staff-nav__blob { border-radius: 42% 58% 37% 63% / 60% 38% 62% 40%; }
  .staff-nav__note.note--about .staff-nav__blob { border-radius: 65% 35% 45% 55% / 48% 62% 38% 52%; }
  .staff-nav__note.note--highlights .staff-nav__blob { border-radius: 38% 62% 55% 45% / 55% 45% 62% 38%; }
  .staff-nav__note.note--lessons .staff-nav__blob { border-radius: 55% 45% 38% 62% / 42% 58% 42% 58%; }
  .staff-nav__note.note--contact .staff-nav__blob { border-radius: 60% 40% 40% 60% / 35% 60% 40% 65%; }
  .staff-nav__note.note--dev .staff-nav__blob { border-radius: 50% 50% 55% 45% / 45% 55% 50% 50%; }

  .staff-nav__tag {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid rgba(233, 237, 245, 0.1);
    padding: 0.32rem 0.75rem;
    border-radius: 5px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) ease, transform var(--dur-fast) ease;
  }

  .staff-nav__note:hover .staff-nav__tag,
  .staff-nav__note:focus-visible .staff-nav__tag {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .staff-nav__note:not(.is-active) .staff-nav__blob {
    opacity: 0.5;
  }

  @keyframes breathe-active {
    0%, 100% { transform: scale(1.05); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.22), 0 2px 10px -4px rgba(0, 0, 0, 0.6); }
    50% { transform: scale(1.15); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0), 0 2px 10px -4px rgba(0, 0, 0, 0.6); }
  }

  .staff-nav__note.is-active .staff-nav__blob {
    animation: breathe-active 2.2s ease-in-out infinite;
    opacity: 1;
  }

  /* the active note's own pulse animation continuously redeclares box-shadow
     every frame, which silently overrides the focus-visible ring below it in
     the cascade - pause the pulse while focused so the ring stays visible */
  .staff-nav__note.is-active:focus-visible .staff-nav__blob {
    animation: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6), 0 4px 20px -8px rgba(0, 0, 0, 0.6);
  }

  /* Desktop staff hides below this width; the hamburger below picks up from here. */
  @media (max-width: 860px) {
    .staff-nav {
      display: none;
    }
  }

  /* The nav's fixed 456px width eats a much bigger share of narrower desktop
     widths just above the hamburger breakpoint - without this, it lands on
     top of the hero photo's subject instead of the empty sky beside them
     (confirmed via real screenshots at 861px, not assumed). Scaling down
     from the same fixed top-right corner keeps every note's relative
     spacing intact - no need to touch the per-note pixel offsets above. */
  @media (min-width: 861px) and (max-width: 1010px) {
    .staff-nav {
      transform-origin: top right;
      transform: scale(0.74);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .staff-nav__blob {
      animation: none !important;
      transition: opacity var(--dur-med) ease, filter var(--dur-base) ease;
      scale: none !important;
      rotate: none !important;
    }
  }

  /* ---- mobile: hamburger + dropdown, same four notes; Logo.astro sits top-left independently ---- */

  /* Matches Logo.astro's mobile size (64px) - the two fixed corner controls
     read as one consistent pair rather than the logo looking bigger than
     the nav trigger beside it. Bumped again from 56px after real-phone
     feedback that it still read small. */
  .staff-toggle {
    display: none;
    position: fixed;
    top: 12px;
    right: 20px;
    z-index: 42;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    background: rgba(10, 14, 23, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(233, 237, 245, 0.12);
    border-radius: 999px;
    cursor: pointer;
  }

  .staff-toggle__bar {
    width: 24px;
    height: 2px;
    background: var(--brass);
    border-radius: 1px;
    transition: transform var(--dur-med) var(--ease-spring), opacity var(--dur-fast) ease;
  }

  .staff-toggle.is-open {
    transform: rotate(90deg);
  }

  .staff-toggle.is-open .staff-toggle__bar:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }
  .staff-toggle.is-open .staff-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .staff-toggle.is-open .staff-toggle__bar:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Halfway between the corner card and the full-screen takeover - full
     width (same 20px side gutter the toggle/logo already sit inside of),
     but height still sized to its own content instead of stretching to
     fill the viewport, so it stays a compact band under the header
     controls rather than covering the page. Same transparency tuning as
     the corner card - low enough that whatever section you're on stays
     legible behind it. */
  .staff-menu {
    display: none;
    position: fixed;
    top: 88px;
    left: 20px;
    right: 20px;
    z-index: 41;
    background-color: rgba(10, 14, 23, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(233, 237, 245, 0.12);
    border-radius: 22px;
    padding: 1.3rem 1.2rem;
    box-shadow: 0 20px 45px -20px rgba(0, 0, 0, 0.7);
  }

  .staff-menu__inner {
    position: relative;
  }

  /* A vertical staff (five lines, sheet-music pitch) running the height of
     the list, echoing the desktop nav's horizontal staff-and-note layout -
     each item's notehead sits on it the same way each desktop note sits on
     its horizontal staff, just rotated to fit a stacked mobile list. Sized
     to the list's own auto content height (no fixed calc): it's absolutely
     positioned inside the same auto-height wrapper as the list, so
     top: 0 / bottom: 0 stretches it to match whatever that turns out to be. */
  .staff-menu__staff {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 44px;
    pointer-events: none;
  }

  .staff-menu__rule {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--staff-line-strong);
  }

  .staff-menu__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .staff-menu__item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    text-align: left;
    text-decoration: none;
    color: inherit;
  }

  .staff-menu__item:focus-visible .staff-menu__label {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* A real notehead: solid circle, icon inside, same per-tone color the
     desktop blob uses - sized to fully cross (occlude) the five staff
     lines behind it, same visual logic as a notehead sitting on a staff. */
  .staff-menu__dot {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg);
    opacity: 0.7;
    box-shadow: 0 4px 20px -8px rgba(0, 0, 0, 0.6);
    transition: opacity var(--dur-base) ease, transform var(--dur-base) ease;
  }

  .staff-menu__icon {
    width: 21px;
    height: 21px;
  }

  .staff-menu__item:hover .staff-menu__dot,
  .staff-menu__item:focus-visible .staff-menu__dot {
    opacity: 0.8;
  }

  .staff-menu__item.is-active .staff-menu__dot {
    opacity: 1;
    transform: scale(1.08);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.16), 0 4px 20px -8px rgba(0, 0, 0, 0.6);
  }

  .staff-menu__label {
    font-family: var(--font-body);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-base) ease;
  }

  .staff-menu__item.is-active .staff-menu__label {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .staff-toggle {
      display: flex;
    }
    /* Rendered at all times at this breakpoint (never [hidden]/display:none)
       so open/close can actually transition instead of popping instantly -
       visibility is delayed on the way out (and instant on the way in) so
       it's still out of the tab/AT order while closed, same as [hidden]
       was, but without losing the animation that requires layout. */
    .staff-menu {
      display: block;
      opacity: 0;
      visibility: hidden;
      transform: translate3d(0, -10px, 0) scale(0.98);
      transform-origin: top center;
      will-change: transform, opacity;
      transition: opacity var(--dur-base) ease, transform var(--dur-base) var(--ease-spring), visibility 0s linear var(--dur-base);
    }
    .staff-menu.is-open {
      opacity: 1;
      visibility: visible;
      transform: translate3d(0, 0, 0) scale(1);
      transition: opacity var(--dur-base) ease, transform var(--dur-base) var(--ease-spring), visibility 0s linear 0s;
    }
    @media (prefers-reduced-motion: reduce) {
      .staff-menu {
        transition: opacity var(--dur-fast) ease, visibility 0s linear var(--dur-fast);
        transform: none;
      }
      .staff-menu.is-open {
        transition: opacity var(--dur-fast) ease, visibility 0s linear 0s;
        transform: none;
      }
    }
  }
</style>

<script>
  const sectionIds = ['listen', 'about', 'career-highlights', 'lessons', 'dev', 'contact'];
  const jumpButtons = Array.from(document.querySelectorAll<HTMLElement>('.staff-jump'));

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  function closeMenu() {
    panel?.classList.remove('is-open');
    panel?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.classList.remove('is-open');
  }

  function openMenu() {
    panel?.classList.add('is-open');
    panel?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.classList.add('is-open');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  document.addEventListener('click', (e) => {
    if (!panel || !panel.classList.contains('is-open')) return;
    const target = e.target as Node;
    if (panel.contains(target) || toggle?.contains(target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  jumpButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      // Logo.astro's home link is a real `<a href="#hero">` (works without JS,
      // matches id="hero"); prevented here so its target section is reached
      // by the same smooth-scroll every other nav item uses. The URL hash is
      // kept in step by the scroll observer below, so it follows wherever the
      // page ends up (and is cleared at the top) instead of staying on
      // whichever anchor was clicked last.
      e.preventDefault();
      const target = document.getElementById(btn.dataset.target ?? '');
      target?.scrollIntoView({ behavior: 'smooth' });
      closeMenu();
    });
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          jumpButtons.forEach((btn) => {
            btn.classList.toggle('is-active', btn.dataset.target === entry.target.id);
          });
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Keep the URL hash on the section being viewed. Plain anchor links (the
  // "Let's Talk" and "Ask about lessons" CTAs, the hero terminal) do a native
  // jump that writes #contact / #listen into the URL; nothing used to update
  // or clear it afterward, so scrolling elsewhere or clicking the logo left a
  // stale #contact (reported 2026-10-16). replaceState, so scrolling never
  // adds history entries; the hero is the top of the page, so it clears the
  // hash. Debounced so a long smooth scroll doesn't flicker through every
  // section. A deep link like /#contact is left alone until the page has
  // scrolled to that section (or the visitor scrolls or presses a key
  // themselves): the page loads at the top and the browser's smooth jump to
  // the anchor passes through other sections first, any of which would
  // otherwise overwrite the hash.
  const urlSectionIds = ['hero', 'intro', 'listen', 'about', 'performance', 'career-highlights', 'press', 'gallery', 'lessons', 'sheet-music', 'dev', 'faq', 'contact'];
  let urlSyncTimer: number | undefined;
  let pendingDeepLink = urlSectionIds.includes(window.location.hash.slice(1)) ? window.location.hash.slice(1) : '';
  ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((type) => {
    window.addEventListener(type, () => { pendingDeepLink = ''; }, { once: true, passive: true });
  });

  function syncUrlHash(id: string) {
    window.clearTimeout(urlSyncTimer);
    urlSyncTimer = window.setTimeout(() => {
      const hash = id === 'hero' ? '' : `#${id}`;
      if (window.location.hash === hash) return;
      window.history.replaceState(window.history.state, '', window.location.pathname + window.location.search + hash);
    }, 150);
  }

  const urlObserver = new IntersectionObserver(
    (entries) => {
      const current = entries.filter((entry) => entry.isIntersecting).pop();
      if (!current) return;
      if (pendingDeepLink) {
        if (current.target.id !== pendingDeepLink) return;
        pendingDeepLink = '';
      }
      syncUrlHash(current.target.id);
    },
    { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
  );

  urlSectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) urlObserver.observe(el);
  });
</script>
