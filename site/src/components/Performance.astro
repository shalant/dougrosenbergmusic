---
const chicagoVenues = ['Millennium Park', 'Green Mill', 'Hothouse', 'Symphony Center', 'Jazz Showcase', 'Taste of Chicago'];

const nationalVenues = [
  "Joe's Pub", 'St. Louis Art Museum', 'Knitting Factory', "Chris' Jazz Café", 'Blues Alley', 'Makor',
  'Satalla', 'Firefly Club', 'Cedar Cultural Center', "Johnny D's", 'Canadian Guitar Festival', 'Alchemia',
  'Krannert Center', 'Dazzle',
];

// The seven collaborators the About paragraph names, set large (2026-11-01):
// the full list below was one unbroken run of small names. The picks come from
// About.astro's own sentence, not a new judgment of who matters most; Doug can
// swap them. Every name still appears exactly once across the two lists.
const featuredArtists = [
  'Sam Barsh', 'Maurice Brown', 'Phil Cohran', 'Robert Glasper',
  'Robert "Baabe" Irving III', 'Rakalam Bob Moses', 'Kendrick Scott',
];

const otherArtists = [
  'Brendan Bayliss', 'Bobby Broom', 'Maggie Brown', 'Oscar Brown Jr.',
  'Ernest Dawkins', 'Michael Franti', 'George Freeman', 'Fareed Haque',
  'Nikki Glaspie', 'Jen Hartswick', 'Keyon Harrold', 'Marquis Hill',
  'Goran Ivanovic', 'Karsh Kale', 'Mark Kelley', 'Kris Myers', 'Jeff Parker',
  'Danilo Pérez', 'Joe Russo', 'Sherry Scott', 'John Sinclair', 'Walter Smith',
  'Oscar Stagnaro', 'Luciana Souza', 'Matt Ulery', 'Corey Wilkes', 'David Young',
];
---

<section id="performance" class="performance">
  <div class="wrap">
    <h2 class="performance__heading">On the Road</h2>

    <div class="performance__venues">
      <div class="performance__venue-group scroll-rise">
        <p class="label performance__venue-label">Chicago</p>
        <ul class="performance__venue-list performance__venue-list--marquee">
          {chicagoVenues.map((v) => <li>{v}</li>)}
        </ul>
      </div>
      <div class="performance__venue-group scroll-rise">
        <p class="label performance__venue-label">National and international</p>
        <ul class="performance__venue-list performance__venue-list--two-col">
          {nationalVenues.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </div>

    <div class="performance__artists scroll-rise">
      <p class="label performance__venue-label">Artists performed with</p>
      <ul class="performance__artists-feature">
        {featuredArtists.map((a) => <li>{a}</li>)}
      </ul>
      <ul class="performance__artists-flow">
        {otherArtists.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .performance {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--bg);
  }

  .performance__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 2.5rem;
  }

  .performance__venues {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 3rem;
  }

  /* The venue groups and the artist list rise in on scroll (.scroll-rise,
     global.css); the second venue column trails the first a little. */
  .performance__venue-group + .performance__venue-group {
    --rise-range: entry 25% cover 32%;
  }

  .performance__venue-label {
    margin: 0 0 0.8rem;
  }

  .performance__venue-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--text);
  }

  /* Chicago is the home stage, so its six venues are set in the display face
     at headline scale; the national list stays small beside it. */
  .performance__venue-list--marquee {
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.25;
  }

  /* Featured collaborators: display italic, wrapping with a brass dot between
     names (same gap-clip trick as the small list). */
  .performance__artists-feature {
    list-style: none;
    margin: 0 0 1.25rem -1.6rem;
    padding: 0;
    clip-path: inset(0 0 0 1.6rem);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    line-height: 1.5;
    color: var(--text);
  }

  .performance__artists-feature li {
    white-space: nowrap;
  }

  .performance__artists-feature li::before {
    content: '·';
    display: inline-block;
    width: 1.6rem;
    text-align: center;
    font-style: normal;
    color: var(--brass);
  }

  .performance__venue-list--two-col {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem 1.5rem;
  }

  /* Names never break mid-name, and the separator dot before each name sits
     in the gap, clipped at line starts (same technique as CareerHighlights'
     school list), so no line ends or begins with a stray "·". */
  .performance__artists-flow {
    list-style: none;
    margin: 0 0 0 -1.4rem;
    padding: 0;
    clip-path: inset(0 0 0 1.4rem);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.98rem;
    line-height: 2;
    color: var(--text);
  }

  .performance__artists-flow li {
    white-space: nowrap;
  }

  .performance__artists-flow li::before {
    content: '·';
    display: inline-block;
    width: 1.4rem;
    text-align: center;
    color: var(--brass);
  }

  @media (max-width: 700px) {
    .performance__venues {
      grid-template-columns: 1fr;
    }

    .performance__venue-group + .performance__venue-group {
      --rise-range: entry 10% cover 25%;
    }
  }
</style>
