---
// Home page press timeline: approved quotes grouped by project, each group with
// a bracket that tells its one-line history and holds the one link to its page.
// Chosen 2026-10-15 from the "Era bracket" prototype. For now this section is
// the only way into /easternblok and /press (see docs/todolist.md). Outlet
// links open the original review; bracket links stay on this site.
import QuoteLedger from './QuoteLedger.astro';
import { easternBlokQuotes, leaderQuotes } from '../data/press-timeline.js';

const eras = [
  {
    key: 'eastern-blok',
    title: 'Eastern Blok',
    lineage: ['Goran Ivanovic Group', 'Eastern Blok, until 2012'],
    meta: '3 albums · Chicago',
    link: { href: '/easternblok', label: 'The archive' },
    quotes: easternBlokQuotes,
  },
  {
    key: 'leader',
    title: 'As leader',
    lineage: [],
    meta: 'Live, sideman and solo work',
    link: { href: '/press', label: 'All press' },
    quotes: leaderQuotes,
  },
];
---

<section id="press" class="press-timeline" aria-labelledby="press-title">
  <div class="wrap">
    <p class="eyebrow">Press</p>
    <h2 id="press-title" class="press-timeline__title">On record</h2>

    <div class="press-timeline__eras">
      {eras.map((era) => (
        <div class={`era era--${era.key}`}>
          <QuoteLedger quotes={era.quotes} />
          <div class="era__bracket">
            <h3 class="era__title">{era.title}</h3>
            {era.lineage.length > 0 && (
              <p class="era__lineage">
                {era.lineage.map((name) => <span>{name}</span>)}
              </p>
            )}
            <p class="era__meta">{era.meta}</p>
            <a class="era__link" href={era.link.href} data-cta={`press-${era.key}`}>{era.link.label} &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .press-timeline {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .press-timeline__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 0;
  }

  .press-timeline__eras {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .era {
    --era-accent: var(--brass);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 13rem);
    gap: 0 2rem;
  }

  .era--leader {
    --era-accent: var(--glow);
  }

  /* The bracket: a vertical rule with short serifs top and bottom, beside
     the rows it groups. Turns into a heading rule above the rows on phones. */
  .era__bracket {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: center;
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 2px solid var(--era-accent);
  }

  .era__bracket::before,
  .era__bracket::after {
    content: '';
    position: absolute;
    left: -2px;
    width: 12px;
    height: 2px;
    background: var(--era-accent);
  }

  .era__bracket::before {
    top: 0;
  }

  .era__bracket::after {
    bottom: 0;
  }

  .era__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .era__lineage {
    margin: 0;
    display: grid;
    gap: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .era__lineage span:first-child {
    color: var(--text-faint);
  }

  .era__lineage span:first-child::after {
    content: ' →';
  }

  .era__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
  }

  /* min-height keeps the tap target at 44px, like the site's other pills. */
  .era__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--era-accent);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .era__link:hover,
  .era__link:focus-visible {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .era {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .era__bracket {
      order: -1;
      border-left: 0;
      border-top: 2px solid var(--era-accent);
      padding: 0.75rem 0 0;
    }

    .era__bracket::before,
    .era__bracket::after {
      display: none;
    }
  }
</style>
