---
// Marks the same section boundaries StaffNav tracks (dev/listen/about/
// career-highlights/contact) - Performance/Gallery/SheetMusicLibrary have
// no nav note, so no divider before them either. The note sits centered
// horizontally rather than spanning full width like the old, cut
// LeadSheetBarShape did - confirmed via screenshot at the worst-case
// scroll position (right under the fixed logo/toggle/desktop-nav) that a
// centered note never collides with those corner-anchored controls,
// unlike a wide strip would.
const ICONS: Record<string, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="m8.5 13.5-1.5 8 5-3 5 3-1.5-8"/>',
  book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  mail: '<path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="m3 6 9 7 9-7"/>',
};

interface Props {
  icon: keyof typeof ICONS;
  tone: string;
  // Short section name revealed beside the icon (see the reveal notes in the
  // <style> block). Same wording as the matching StaffNav tag.
  label: string;
}
const { icon, tone, label } = Astro.props;
---

<div class={`staff-divider note--${tone}`} aria-hidden="true">
  <div class="staff-divider__line" style="top: 20px;"></div>
  <div class="staff-divider__line" style="top: 32px;"></div>
  <div class="staff-divider__line" style="top: 44px;"></div>
  <div class="staff-divider__line" style="top: 56px;"></div>
  <div class="staff-divider__line" style="top: 68px;"></div>
  <span class="staff-divider__note">
    <svg class="staff-divider__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon]} />
    <span class="staff-divider__label">{label}</span>
  </span>
</div>

<style>
  .staff-divider {
    position: relative;
    width: 100%;
    height: 88px;
    overflow: hidden;
  }

  .staff-divider__line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--staff-line-strong);
  }

  .staff-divider__note {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    min-width: 64px;
    height: 64px;
    box-sizing: border-box;
    /* 18 + 28px icon + 18 = 64: the resting circle is unchanged, but the open
       pill gets even padding on both ends instead of the icon hugging the edge. */
    padding-inline: 18px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg);
    box-shadow: 0 4px 20px -8px rgba(0, 0, 0, 0.6);
  }

  .staff-divider__icon {
    flex: none;
    width: 28px;
    height: 28px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .staff-divider__note:hover .staff-divider__icon {
    transform: rotate(-12deg) scale(1.12);
  }

  /* Micro-interaction: the blob stretches into a pill and the section name
     slides out beside the icon. The label starts at zero width (and the pill
     shrinks back to a 64px circle via min-width) so the resting state is
     exactly the old static note.
     - Where scroll-driven animations exist (Chromium, Safari 26+), it plays
       as the divider scrolls in and then stays open. No JS, so no new inline
       script and no CSP hash to regenerate; it also works on touch, where
       hover doesn't exist.
     - Elsewhere it falls back to opening on hover.
     The divider is aria-hidden and decorative (StaffNav already names the
     sections), so there's deliberately no focus/click behavior to add. */
  .staff-divider__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    max-width: 0;
    opacity: 0;
    margin-left: 0;
  }

  @supports (animation-timeline: view()) {
    .staff-divider {
      view-timeline-name: --divider;
      view-timeline-axis: block;
    }

    .staff-divider__label {
      animation: staff-divider-reveal linear both;
    }

    .staff-divider__icon {
      animation: staff-divider-pop linear both;
    }

    /* Separate, more specific rules on purpose: the minifier folds
       animation-timeline into the `animation` shorthand when they share a
       rule, and shorthand-with-timeline isn't parsed everywhere that
       supports the longhand, which silently dropped the whole animation. */
    .staff-divider .staff-divider__label {
      animation-timeline: --divider;
      animation-range: entry 25% cover 50%;
    }

    .staff-divider .staff-divider__icon {
      animation-timeline: --divider;
      animation-range: entry 15% cover 40%;
    }
  }

  @supports not (animation-timeline: view()) {
    .staff-divider__label {
      transition: max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease 0.1s, margin-left 0.45s ease;
    }

    .staff-divider__note:hover .staff-divider__label {
      max-width: 9rem;
      opacity: 1;
      margin-left: 0.6rem;
    }
  }

  @keyframes staff-divider-reveal {
    to {
      max-width: 9rem;
      opacity: 1;
      margin-left: 0.6rem;
    }
  }

  /* A little squash-and-settle on the icon as the pill starts to open. */
  @keyframes staff-divider-pop {
    0% { transform: scale(0.8); }
    60% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .staff-divider__label,
    .staff-divider__icon {
      animation: none;
      transition: none;
    }

    .staff-divider__note:hover .staff-divider__icon {
      transform: none;
    }
  }

  .staff-divider.note--dev .staff-divider__note { background: var(--note-dev); }
  .staff-divider.note--listen .staff-divider__note { background: var(--note-listen); }
  .staff-divider.note--about .staff-divider__note { background: var(--note-about); }
  .staff-divider.note--highlights .staff-divider__note { background: var(--note-highlights); }
  .staff-divider.note--lessons .staff-divider__note { background: var(--note-lessons); }
  .staff-divider.note--contact .staff-divider__note { background: var(--note-contact); }
</style>
