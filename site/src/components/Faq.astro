---
// Visible FAQ (native <details>, no JS) plus matching FAQPage JSON-LD built
// from the same array, so the markup and the schema can never drift apart.
// Answers stay plain text on purpose - FAQPage schema doesn't want markup,
// and the visible copy should read identically to what a crawler ingests.
// Facts here mirror public/llms.txt; update both together.
const faqs = [
  {
    q: 'Who is Doug Rosenberg?',
    a: "Doug Rosenberg is a Chicago-based jazz saxophonist, composer, and educator. He has performed at Millennium Park, the Green Mill, Symphony Center, and Joe's Pub, and with Robert Glasper, Kendrick Scott, and Danilo Pérez. He also designs and builds websites.",
  },
  {
    q: 'What has he recorded?',
    a: 'His debut album Better Than TV (2014), plus albums with Eastern Blok (Underwater and Folk Tales) and the Goran Ivanovic Group.',
  },
  {
    q: 'Does he teach saxophone?',
    a: 'Yes. Doug teaches private lessons in saxophone, clarinet, flute, jazz improvisation, and music theory for beginner through advanced students. He was also the jazz improvisation and saxophone instructor at New Trier High School from 2003 to 2011. Use the contact form to ask about availability.',
  },
  {
    q: 'Does he also build websites?',
    a: 'Yes, alongside music. Doug takes on web design, development, branding, and ongoing support for musicians and small businesses. Examples of client and personal work are in the web section on this page and at dougrosenbergdev.com.',
  },
  {
    q: 'How do I contact him?',
    a: 'Use the contact form on this page, or email doug.rosenberg@gmail.com.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<section id="faq" class="faq">
  <div class="wrap faq__layout">
    <div class="faq__intro">
      <h2 class="faq__heading">Quick answers</h2>
      <p class="faq__more">Something not covered here? Ask Doug directly.</p>
      <a class="cta cta-secondary faq__ask" href="#contact">Send a message</a>
    </div>

    <div class="faq__list">
      {faqs.map(({ q, a }) => (
        <details class="faq__item scroll-rise">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: transparent;
  }

  .faq__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0.25rem 0 2rem;
  }

  /* From 1000px the heading and a way to ask something else sit in the left
     column and the questions in the right, so the section uses the whole
     content width instead of leaving its right half empty (2026-11-15, bad
     cop). Below that the invitation is hidden and the section is unchanged. */
  .faq__more,
  .faq__ask {
    display: none;
  }

  @media (min-width: 1000px) {
    .faq__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: start;
    }

    .faq__heading {
      margin-bottom: 1rem;
    }

    .faq__more {
      display: block;
      margin: 0 0 1.5rem;
      max-width: 22rem;
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    .faq__ask {
      display: inline-flex;
    }

    .faq__layout .faq__list {
      /* the old cap was for a lone column; the grid cell sets the width now */
      max-width: none;
      /* lines the first rule up with the heading's cap height */
      margin-top: 0.9rem;
    }
  }

  /* Ruled rows, not five identical rounded cards (2026-10-29): the cards
     were the page's last template pattern in the 2026-10-29 re-score. Same
     hairline rule the Lessons subject list uses. */
  .faq__list {
    max-width: 48rem;
    border-top: 1px solid var(--staff-line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--staff-line-strong);
  }

  .faq__item summary {
    cursor: pointer;
    padding-block: 1.1rem;
    font-weight: 600;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .faq__item summary:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 2px;
    border-radius: 0.5rem;
  }

  .faq__item p {
    margin: 0 0 1.1rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Open/closed indicator (2026-10-17): `display: flex` on the summary
     drops the browser's own marker, so nothing showed a question could
     open. A "+" that turns to "×", same as the /easternblok show years. */
  .faq__item summary {
    gap: 1rem;
    list-style: none;
  }

  /* Each answer row rises in on its own (.scroll-rise, global.css), finishing
     as it enters the screen, so the list cascades as you scroll (2026-11-17). */
  .faq__item {
    --rise-range: entry 5% entry 85%;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--brass);
    transition: rotate var(--dur-med) var(--ease-spring), scale var(--dur-base) ease;
  }

  .faq__item[open] summary::after {
    rotate: 45deg;
  }

  /* The row answers the pointer: the "+" swells a little (2026-10-30). */
  @media (hover: hover) {
    .faq__item summary:hover::after {
      scale: 1.4;
    }
  }

  /* A press squeezes the "+" (2026-11-17), after the hover rule so it wins
     while the pointer is down. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item summary:active::after {
      scale: 0.8;
    }
  }

  /* The answer slides open instead of popping in, where the browser can
     animate to `height: auto`; elsewhere it just opens as before. */
  @supports selector(::details-content) {
    .faq__item {
      interpolate-size: allow-keywords;
    }
    .faq__item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size var(--dur-med) ease, content-visibility var(--dur-med) allow-discrete;
    }
    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item summary::after,
    .faq__item::details-content {
      transition: none;
    }
  }
</style>
