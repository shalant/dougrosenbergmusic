---
const email = 'doug.rosenberg@gmail.com';
const socials = [
  { label: 'Instagram', href: 'https://instagram.com/shalantdoro' },
  { label: 'YouTube', href: 'https://youtube.com/@dougrosenberg2361' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/douglasrosenberg' },
  { label: 'GitHub', href: 'https://github.com/shalant' },
];
---

<section id="contact" class="contact">
  <div class="wrap">
    <p class="eyebrow">Booking &amp; Contact</p>
    <h2 class="contact__heading">Let&rsquo;s make some music.</h2>
    <p class="contact__sub">Available for performances, sessions, and private instruction.</p>

    <a class="contact__cta" href={`mailto:${email}`}>
      {email}
      <span aria-hidden="true">→</span>
    </a>

    <nav class="contact__socials" aria-label="Social links">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </nav>

    <div class="contact__form-wrap">
      <p class="contact__form-label">Or send a message directly</p>
      <form id="contact-form" class="contact__form" novalidate>
        <div class="contact__field">
          <label for="contact-name">Name</label>
          <input type="text" id="contact-name" name="name" required maxlength="200" autocomplete="name" />
        </div>
        <div class="contact__field">
          <label for="contact-email">Email</label>
          <input type="email" id="contact-email" name="email" required maxlength="200" autocomplete="email" />
        </div>
        <div class="contact__field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" required maxlength="5000" rows="5"></textarea>
        </div>
        <!-- Honeypot: hidden from real visitors via off-screen positioning
             (not `hidden`/display:none — some bots skip fields detected via
             those too crudely), invisible and unreachable by tab/keyboard. -->
        <div class="contact__field contact__honeypot" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="contact__submit">Send Message</button>
        <p id="contact-form-status" class="contact__form-status" role="status"></p>
      </form>
    </div>
  </div>

  <footer class="contact__footer">
    <p>© {new Date().getFullYear()} Doug Rosenberg</p>
  </footer>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-form-status') as HTMLParagraphElement;
  const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = '';
    status.className = 'contact__form-status';

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? '').trim(),
      email: String(formData.get('email') ?? '').trim(),
      message: String(formData.get('message') ?? '').trim(),
      website: String(formData.get('website') ?? ''),
    };

    if (!payload.name || !payload.email || !payload.message) {
      status.textContent = 'Please fill in your name, email, and message.';
      status.classList.add('contact__form-status--error');
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (response.ok) {
        status.textContent = "Message sent — thanks! I'll reply within a few days.";
        status.classList.add('contact__form-status--success');
        form.reset();
      } else {
        status.textContent = result.error || 'Something went wrong. Please email directly instead.';
        status.classList.add('contact__form-status--error');
      }
    } catch {
      status.textContent = 'Something went wrong. Please email directly instead.';
      status.classList.add('contact__form-status--error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send Message';
    }
  });
</script>

<style>
  .contact {
    padding-block: clamp(5rem, 12vw, 8.5rem) clamp(2rem, 4vw, 3rem);
    background: linear-gradient(180deg, var(--bg) 0%, #060810 100%);
    text-align: center;
  }

  .contact__heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 3.75rem);
    margin: 0.5rem 0 0.6rem;
  }

  .contact__sub {
    color: var(--text-muted);
    margin: 0 0 2.5rem;
  }

  .contact__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--bg);
    background: var(--brass);
    text-decoration: none;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact__cta:hover,
  .contact__cta:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px var(--brass-soft);
  }

  .contact__cta:focus-visible {
    outline: none;
    box-shadow: 0 10px 30px var(--brass-soft), 0 0 0 3px rgba(255, 255, 255, 0.6);
  }

  .contact__cta span {
    transition: transform 0.2s ease;
  }

  .contact__cta:hover span,
  .contact__cta:focus-visible span {
    transform: translateX(3px);
  }

  .contact__socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.75rem;
  }

  .contact__socials a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .contact__socials a:hover {
    color: var(--text);
    border-color: var(--brass);
  }

  .contact__footer {
    margin-top: 4.5rem;
    text-align: center;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  /* the email address is long enough at the mono font's clamp() minimum that
     the pill's default padding pushes it past the viewport at ~320px-wide
     phones (confirmed via a real horizontal-scrollWidth check, not assumed) -
     tighter padding here is enough to close the gap without needing the pill
     to wrap onto two lines. */
  @media (max-width: 360px) {
    .contact__cta {
      padding: 1rem 1rem;
      gap: 0.5rem;
    }
  }

  .contact__form-wrap {
    max-width: 480px;
    margin: 3.5rem auto 0;
    text-align: left;
  }

  .contact__form-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass);
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
  }

  .contact__field label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .contact__field input,
  .contact__field textarea {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid rgba(233, 237, 245, 0.14);
    border-radius: 7px;
    padding: 0.65rem 0.8rem;
  }

  .contact__field textarea {
    resize: vertical;
  }

  .contact__field input:focus-visible,
  .contact__field textarea:focus-visible {
    outline: none;
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.14);
  }

  .contact__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact__submit {
    display: block;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--bg);
    background: var(--brass);
    border: none;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact__submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px var(--brass-soft);
  }

  .contact__submit:focus-visible {
    outline: none;
    box-shadow: 0 10px 30px var(--brass-soft), 0 0 0 3px rgba(255, 255, 255, 0.6);
  }

  .contact__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .contact__form-status {
    min-height: 1.3em;
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    text-align: center;
    color: var(--text-muted);
  }

  .contact__form-status--success {
    color: var(--note-cred);
  }

  .contact__form-status--error {
    color: var(--note-about);
  }
</style>
