---
const schools = [
  'Princeton University', 'University of Michigan', 'Cornell University',
  'Carnegie Mellon University', 'University of Pittsburgh', 'Lewis University',
  'SUNY Fredonia', 'University of Minnesota', 'University of Nebraska',
  'Haverford College', 'Elgin Community College', 'Francis Parker School',
  'New Trier High School', 'Kennedy High School',
];
---

<section id="career-highlights" class="career-highlights staff-lines--strong">
  <div class="wrap">
    <h2 class="career-highlights__title">Highlights</h2>
    <p class="label career-highlights__intro">Guest artist and visiting instructor at</p>
    <ul class="career-highlights__list scroll-rise">
      {schools.map((school) => (
        <li>{school}</li>
      ))}
    </ul>

    <div class="career-highlights__grid">
      <div class="career-highlights__block scroll-rise">
        <h3 class="career-highlights__heading">New Trier High School</h3>
        <ul class="career-highlights__bullets">
          <li><span>Freshman Jazz Ensemble Assistant</span><span class="career-highlights__years">2005–2008</span></li>
          <li><span>Jazz Improvisation Instructor</span><span class="career-highlights__years">2003–2008</span></li>
          <li><span>Saxophone Instructor</span><span class="career-highlights__years">2007–2011</span></li>
        </ul>
        <h3 class="career-highlights__heading career-highlights__heading--spaced">Lake Forest Country Day School</h3>
        <ul class="career-highlights__bullets">
          <li><span>Band Director</span><span class="career-highlights__years">Fall 2012</span></li>
        </ul>
      </div>

      <div class="career-highlights__block scroll-rise">
        <h3 class="career-highlights__heading">Professional Affiliations</h3>
        <ul class="career-highlights__bullets">
          <li><span>Member, International Association of Jazz Educators</span><span class="career-highlights__years">since 2005</span></li>
          <li><span>Endorsed by Selmer Saxophones</span></li>
        </ul>
        <h3 class="career-highlights__heading career-highlights__heading--spaced">Education</h3>
        <ul class="career-highlights__bullets">
          <li><span><strong>New England Conservatory</strong> — Bachelor of Music, Jazz Performance</span><span class="career-highlights__years">1997–2002</span></li>
          <li><span><strong>BS in Chemistry</strong></span><span class="career-highlights__years">1997–2002</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .career-highlights {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--surface);
    border-block: 1px solid rgba(233, 237, 245, 0.08);
  }

  .career-highlights__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 0;
  }

  /* Each separator sits in the gap *before* its item, and the list is shifted
     left by one gap and clipped, so the dot in front of a line's first item
     falls outside the clip. A trailing ::after dot left an orphan "·" at the
     end of every wrapped line on phones. */
  .career-highlights__intro {
    margin: 1.25rem 0 0;
  }

  /* Body face at body size in full-strength text (2026-10-25): it was
     0.78rem mono in muted grey, the smallest and dimmest text on the page
     for a list that's real credentials. */
  .career-highlights__list {
    list-style: none;
    margin: 0.6rem 0 0 -1.4rem;
    padding: 0 0 0 1.4rem;
    clip-path: inset(0 0 0 1.4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    font-size: 0.98rem;
    color: var(--text);
  }

  .career-highlights__list li::before {
    content: '·';
    display: inline-block;
    width: 1.4rem;
    margin-left: -1.4rem;
    text-align: center;
    color: var(--brass);
  }

  .career-highlights__grid {
    display: grid;
    /* Two blocks since the private-lessons content moved to Lessons.astro. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 3rem);
    margin-top: 2.75rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(233, 237, 245, 0.1);
  }

  /* Both blocks rise in on scroll (.scroll-rise, global.css); the second
     trails the first a little when they sit side by side. */
  .career-highlights__block + .career-highlights__block {
    --rise-range: entry 25% cover 32%;
  }

  .career-highlights__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0 0 0.9rem;
  }

  .career-highlights__heading--spaced {
    margin-top: 1.75rem;
  }

  .career-highlights__text {
    margin: 0 0 0.9rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Ruled rows, like the FAQ (2026-10-30): these were 0.86rem grey bullets,
     the smallest and dimmest text on the page for real credentials. The role
     reads at body size in full-strength text and the years sit at the right
     edge, wrapping under the role on a narrow screen. */
  .career-highlights__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text);
  }

  .career-highlights__bullets li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.1rem 1.25rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--staff-line-strong);
  }

  .career-highlights__bullets li:last-child {
    border-bottom: 1px solid var(--staff-line-strong);
  }

  .career-highlights__bullets strong {
    font-weight: 500;
  }

  .career-highlights__years {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-left: auto;
  }

  @media (max-width: 900px) {
    .career-highlights__grid {
      grid-template-columns: 1fr;
    }

    .career-highlights__block + .career-highlights__block {
      --rise-range: entry 10% cover 25%;
    }
  }
</style>
