---
// Every other piece of coverage, one expandable list per year: previews,
// interviews, listings, mentions, band-issued announcements. Rows are in the
// HTML at load (closed <details>), like the show list. Data and labels from
// src/data/press-archive.js.
import { KIND_LABEL, dateLabel, highlightName, isFromBand, isTranslated, shortQuote, sortDate } from '../data/press-archive.js';

interface Props {
  years: [string, any[]][];
}

const { years } = Astro.props;
const kindLabel = (kind: string) => KIND_LABEL[kind as keyof typeof KIND_LABEL];
---

<div class="years">
  {years.map(([year, entries]) => (
    <details class="year">
      <summary>
        <span class="year__label">{year}</span>
        <span class="year__count">{entries.length} {entries.length === 1 ? 'piece' : 'pieces'}</span>
      </summary>
      <ol class="year__list">
        {entries.map((entry) => {
          const quote = shortQuote(entry);
          const when = dateLabel(sortDate(entry));
          return (
            <li class="clip">
              <span class="clip__date">{when}</span>
              <div class="clip__body">
                <p class="clip__title">
                  {entry.url ? (
                    <a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
                  ) : (
                    entry.title
                  )}
                </p>
                <p class="clip__outlet">{entry.outlet}{entry.author && `, ${entry.author}`}</p>
                {entry.showDates?.length > 0 && (
                  <p class="clip__shows">Lists shows on {entry.showDates.slice(0, 8).map((d: string) => dateLabel(d, true)).join(', ')}</p>
                )}
                {quote && (
                  <p class="clip__quote">
                    &ldquo;{highlightName(quote).map((part) => (part.name ? <span class="clip__name">{part.text}</span> : part.text))}&rdquo;
                  </p>
                )}
              </div>
              <p class="clip__tags">
                <span>{isFromBand(entry) && entry.kind !== 'promo-bio' ? `${kindLabel(entry.kind)}, from the band` : kindLabel(entry.kind)}</span>
                {!entry.url && <span>no live page</span>}
                {entry.archiveUrl && <a href={entry.archiveUrl} target="_blank" rel="noopener noreferrer">archived copy<span class="visually-hidden"> (opens in a new tab)</span></a>}
                {isTranslated(entry) && <span>translated</span>}
                {entry.verified === false && entry.url && <span>not confirmed</span>}
              </p>
            </li>
          );
        })}
      </ol>
    </details>
  ))}
</div>

<style>
  .years {
    border-top: 1px solid var(--staff-line-strong);
  }

  .year {
    border-bottom: 1px solid var(--staff-line-strong);
  }

  .year summary {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    min-height: 44px;
    padding-block: 0.9rem;
    cursor: pointer;
    list-style: none;
  }

  .year summary::-webkit-details-marker {
    display: none;
  }

  .year summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-body);
    color: var(--brass);
    transition: rotate var(--dur-med) var(--ease-spring), scale var(--dur-base) ease;
  }

  .year[open] summary::after {
    rotate: 45deg;
  }

  /* The row answers the pointer: the "+" swells a little (2026-10-30). */
  @media (hover: hover) {
    .year summary:hover::after {
      scale: 1.4;
    }
  }

  .year summary:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .year__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.6rem;
    line-height: 1;
    font-variant-numeric: lining-nums;
    min-width: 2.6em;
  }

  .year__count {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .year summary::after {
      transition: none;
    }
  }

  .year__list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .clip {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 11rem;
    gap: 0.25rem 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid rgba(233, 237, 245, 0.05);
  }

  .clip p {
    margin: 0;
  }

  .clip__date {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-faint);
    padding-top: 0.2rem;
  }

  .clip__body {
    display: grid;
    gap: 0.2rem;
  }

  .clip__title {
    color: var(--text);
    text-wrap: pretty;
  }

  .clip__title a {
    color: inherit;
    text-underline-offset: 3px;
    text-decoration-color: rgba(233, 237, 245, 0.3);
  }

  .clip__title a:hover,
  .clip__title a:focus-visible {
    text-decoration-color: var(--brass);
  }

  .clip__outlet {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .clip__shows {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .clip__quote {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .clip__name {
    color: var(--brass);
  }

  .clip__tags {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-end;
    gap: 0.15rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-faint);
    text-align: right;
  }

  .clip__tags a {
    color: var(--text-muted);
    text-underline-offset: 3px;
    display: inline-block;
    padding-block: 0.7rem;
    margin-block: -0.7rem;
  }

  @media (max-width: 700px) {
    .clip {
      grid-template-columns: 3.75rem minmax(0, 1fr);
    }

    .clip__tags {
      grid-column: 2;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
