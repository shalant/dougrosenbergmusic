---
interface Props {
  antenna?: boolean;
}

const { antenna = false } = Astro.props;
---

<header id="hero" class="hero">
  <div class="hero__content wrap">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">Saxophonist · Composer · Educator</p>
      <h1 class="hero__name">Doug<br />Rosenberg</h1>

      <a class="now-playing" href="#listen">
        <span class="now-playing__rec" aria-hidden="true"></span>
        <span class="now-playing__label">On Air</span>
        <span class="now-playing__track">Better Than TV</span>
      </a>
    </div>

    <div class="tv-set" data-tv-set data-variant="b">
      <div class="tv-toggle" role="group" aria-label="TV frame weight">
        <button type="button" class="tv-toggle__btn" data-variant-btn="b" aria-pressed="true">Tabletop</button>
        <button type="button" class="tv-toggle__btn" data-variant-btn="a" aria-pressed="false">Screen only</button>
      </div>
      <div class="tv-set__cabinet">
        {antenna && (
          <div class="tv-set__antenna" aria-hidden="true">
            <span class="tv-set__signal"></span>
          </div>
        )}
        <div class="tv-set__screen">
          <img class="tv-set__photo" src={`${import.meta.env.BASE_URL}images/hero.webp`} alt="Doug Rosenberg holding a saxophone" />
          <div class="tv-set__scanlines" aria-hidden="true"></div>
          <div class="tv-set__vignette" aria-hidden="true"></div>
        </div>
        <div class="tv-set__knobs" aria-hidden="true">
          <span class="tv-set__knob"></span>
          <span class="tv-set__knob"></span>
        </div>
      </div>
      <div class="tv-set__glow" aria-hidden="true"></div>
    </div>
  </div>

  <span class="hero__scroll-cue" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9" />
    </svg>
    <span class="hero__scroll-cue-label">CH +</span>
  </span>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg);
  }

  .hero::before {
    /* faint staff texture on the bare wall behind the set, in place of the full-bleed photo */
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--staff-line) 0px, var(--staff-line) 1px, transparent 1px, transparent 11px,
      var(--staff-line) 11px, var(--staff-line) 12px, transparent 12px, transparent 23px,
      var(--staff-line) 23px, var(--staff-line) 24px, transparent 24px, transparent 220px
    );
    opacity: 0.5;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: 6rem;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .hero__eyebrow {
    margin: 0;
  }

  .hero__name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.98;
    margin: 0;
    color: var(--text);
    text-shadow: 0 0 42px var(--glow-soft), 0 0 4px rgba(127, 176, 255, 0.35);
  }

  .now-playing {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: rgba(19, 26, 38, 0.72);
    border: 1px solid rgba(233, 237, 245, 0.12);
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .now-playing:hover {
    border-color: var(--brass);
    background: rgba(19, 26, 38, 0.9);
  }

  .now-playing__rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e0574f;
    animation: rec-pulse 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  .now-playing__label {
    color: #e0574f;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .now-playing__track {
    color: var(--text-muted);
  }

  @keyframes rec-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ── the set ── */
  .tv-set {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
  }

  .tv-set__glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle at 50% 45%, rgba(207, 154, 79, 0.18), transparent 65%);
    z-index: -1;
    filter: blur(4px);
  }

  .tv-toggle {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
    margin-bottom: 0.9rem;
  }

  /* clear room for the antenna above the cabinet when it's present */
  .tv-set:has(.tv-set__antenna) .tv-toggle {
    margin-bottom: 2.75rem;
  }

  .tv-toggle__btn {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(19, 26, 38, 0.55);
    border: 1px solid rgba(233, 237, 245, 0.14);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tv-toggle__btn[aria-pressed='true'] {
    color: var(--text);
    border-color: var(--brass);
  }

  .tv-set__cabinet {
    position: relative;
    background: linear-gradient(155deg, #e4ddc9 0%, #cfc6ac 55%, #bcb195 100%);
    border-radius: 26px;
    padding: 1.1rem 1.1rem 2.1rem;
    box-shadow: 0 30px 60px -22px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: background 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease;
  }

  .tv-set__screen {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: #0d0906;
    box-shadow: inset 0 0 0 6px #17130f;
    transition: border-radius 0.3s ease, box-shadow 0.3s ease;
  }

  /* Variant A — screen only, no cabinet: the "not too heavy" option */
  .tv-set[data-variant='a'] .tv-set__cabinet {
    background: none;
    padding: 0;
    box-shadow: none;
  }

  .tv-set[data-variant='a'] .tv-set__screen {
    border-radius: 46% 46% 42% 42% / 38% 38% 44% 44%;
    box-shadow: inset 0 0 0 0 transparent, 0 0 46px 8px rgba(207, 154, 79, 0.22);
  }

  .tv-set[data-variant='a'] .tv-set__knobs {
    display: none;
  }

  .tv-set__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: sepia(0.3) saturate(1.2) contrast(1.08) brightness(0.92);
  }

  .tv-set__scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 3px
    );
    mix-blend-mode: overlay;
  }

  .tv-set__vignette {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 60px 18px rgba(0, 0, 0, 0.75);
  }

  .tv-set__knobs {
    position: absolute;
    bottom: 0.7rem;
    right: 1.3rem;
    display: flex;
    gap: 0.6rem;
  }

  .tv-set__knob {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #8c8368;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.5), 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  /* ── rabbit ears: a detail, not a redesign — same frame either variant ── */
  .tv-set__antenna {
    position: absolute;
    top: -34px;
    left: 50%;
    transform: translateX(-50%);
    width: 74px;
    height: 34px;
    z-index: 2;
  }

  .tv-set__antenna::before,
  .tv-set__antenna::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 2px;
    height: 34px;
    background: linear-gradient(to top, var(--brass), rgba(207, 154, 79, 0.3));
    border-radius: 2px;
    transform-origin: bottom center;
  }

  .tv-set__antenna::before {
    transform: translateX(-1px) rotate(-22deg);
  }

  .tv-set__antenna::after {
    transform: translateX(-1px) rotate(22deg);
  }

  .tv-set__signal {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6fdc8c;
    box-shadow: 0 0 7px 1.5px rgba(111, 220, 140, 0.7);
    animation: signal-blink 2.6s ease-in-out infinite;
  }

  @keyframes signal-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tv-set__signal {
      animation: none;
    }
  }

  .tv-set[data-variant='a'] .tv-set__antenna {
    top: -30px;
  }

  .hero__scroll-cue {
    position: absolute;
    z-index: 1;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: 2.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    color: var(--text-faint);
    animation: bob 2s ease-in-out infinite;
  }

  .hero__scroll-cue-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .now-playing__rec,
    .hero__scroll-cue {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .hero__content {
      grid-template-columns: 1fr;
      padding-block: 7rem 4rem;
      gap: 2.5rem;
    }
    .tv-set {
      width: min(100%, 320px);
      justify-self: start;
    }
  }

  @media (max-width: 640px) {
    .hero__scroll-cue {
      display: none;
    }
  }
</style>

<script>
  const tvSet = document.querySelector<HTMLElement>('[data-tv-set]');
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-variant-btn]'));

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const variant = btn.dataset.variantBtn ?? 'b';
      tvSet?.setAttribute('data-variant', variant);
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    });
  });
</script>
