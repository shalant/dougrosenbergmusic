<style>
  .logo {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 40;
    display: block;
    width: 104px;
    height: 104px;
    border-radius: 10px;
    transition: transform 0.2s ease;
  }

  .logo:hover {
    transform: scale(1.06);
  }

  .logo:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6);
  }

  .logo__mark {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.5));
  }
</style>
