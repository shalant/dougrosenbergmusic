---
const photos = [
  { src: '/images/gallery/formal.jpg', caption: 'Concert Performance' },
  { src: '/images/gallery/jazzgallery.jpg', caption: 'Live at the Jazz Gallery' },
  { src: '/images/gallery/andys.jpg', caption: "Andy's Jazz Club — Chicago" },
  { src: '/images/gallery/lakebluff.jpg', caption: 'Lake Bluff' },
  { src: '/images/gallery/barshpolkadots.jpg', caption: 'With Sam Barsh' },
  { src: '/images/gallery/alison.jpg', caption: 'With Alison' },
  { src: '/images/gallery/liliya.jpg', caption: 'With Liliya' },
  { src: '/images/gallery/makaya.jpg', caption: 'With Makaya' },
  { src: '/images/gallery/birdwalker.jpg', caption: 'Bird Walker' },
  { src: '/images/gallery/whistlerfatalbert.jpg', caption: 'Whistler Fat Albert' },
  { src: '/images/gallery/studio.jpg', caption: 'Recording Session' },
  { src: '/images/gallery/artsy.jpg', caption: 'In the Studio' },
  { src: '/images/gallery/chopin-album.jpg', caption: 'Chopin Recording' },
  { src: '/images/gallery/sepia.jpg', caption: 'Vintage' },
  { src: '/images/gallery/profile.jpg', caption: 'Doug Rosenberg' },
  { src: '/images/gallery/betterthantv.jpg', caption: 'Better Than TV' },
  { src: '/images/gallery/albumcover.jpg', caption: 'Album Cover' },
  { src: '/images/gallery/ryangosling.jpg', caption: 'Backstage' },
  { src: '/images/gallery/FB_IMG_1789766115687.jpg', caption: 'In the Moment' },
  { src: '/images/gallery/FB_IMG_1789766123568.jpg', caption: 'Deep in It' },
  { src: '/images/gallery/FB_IMG_1789766128152.jpg', caption: 'Late Set' },
  { src: '/images/gallery/FB_IMG_1789766153467.jpg', caption: 'Bass in Motion' },
  { src: '/images/gallery/FB_IMG_1789766238165.jpg', caption: 'Bandstand, Summer Gig' },
  { src: '/images/gallery/FB_IMG_1789766245653.jpg', caption: 'Gazebo Set' },
  { src: '/images/gallery/FB_IMG_1789766268266.jpg', caption: 'Formal Affair' },
  { src: '/images/gallery/FB_IMG_1789766293776.jpg', caption: 'Red Room' },
  { src: '/images/gallery/FB_IMG_1789766306858.jpg', caption: 'Full Band, Patio Night' },
  { src: '/images/gallery/657564738_10164395654398304_5888319851979648321_n.jpg', caption: 'Soprano Under the Lights' },
  { src: '/images/gallery/blursax.jpg', caption: 'Long Exposure' },
  { src: '/images/gallery/cases.jpg', caption: 'Load-In' },
  { src: '/images/gallery/cityWinery.jpg', caption: 'City Winery, Chicago' },
  { src: '/images/gallery/fluteAlchemia.jpg', caption: 'Flute, Alchemia' },
  { src: '/images/gallery/fluteWebster.jpg', caption: "Flute at Webster's" },
  { src: '/images/gallery/quartetWebster.jpg', caption: "Quartet at Webster's" },
  { src: '/images/gallery/starwars.jpg', caption: 'Costume Gig' },
  { src: '/images/gallery/websterBW.jpg', caption: "Webster's, Late Set" },
  { src: '/images/gallery/websters.jpg', caption: "Solo, Webster's" },
];
---

<section id="gallery" class="gallery staff-lines">
  <div class="wrap gallery__head">
    <p class="eyebrow">Photo Gallery</p>
    <h2 class="gallery__heading">In Frame</h2>
  </div>

  <div class="reel-stage" data-stage>
    <span class="reel-hint" data-hint>auto-playing &middot; drag or scroll</span>
    <div class="reel-track" data-reel>
      {photos.map((p, i) => (
        <button class="reel-panel" data-index={i} aria-label={`Open ${p.caption}`}>
          <img class="reel-panel__img" src={`${import.meta.env.BASE_URL}${p.src.replace(/^\//, '')}`} alt={p.caption} loading="lazy" draggable="false" />
          <span class="reel-panel__caption">
            <span>{p.caption}</span>
            <span class="reel-panel__index">{String(i + 1).padStart(2, '0')} / {String(photos.length).padStart(2, '0')}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div class="wrap gallery__filmstrip">
    <div class="reel-thumbs" data-thumbs>
      {photos.map((p, i) => (
        <button class="reel-thumb" data-index={i} aria-label={`Jump to ${p.caption}`}>
          <img src={`${import.meta.env.BASE_URL}${p.src.replace(/^\//, '')}`} alt="" loading="lazy" />
        </button>
      ))}
    </div>
    <div class="reel-progress"><div class="reel-progress__fill" data-progress></div></div>
  </div>

  <div class="gallery__lightbox" data-lightbox hidden>
    <button class="gallery__lightbox-close" data-lightbox-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <span class="gallery__lightbox-counter" data-lightbox-counter></span>
    <button class="gallery__lightbox-nav gallery__lightbox-nav--prev" data-lightbox-prev aria-label="Previous photo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="gallery__lightbox-content">
      <img data-lightbox-img src="" alt="" />
      <p class="gallery__lightbox-caption" data-lightbox-caption></p>
    </div>
    <button class="gallery__lightbox-nav gallery__lightbox-nav--next" data-lightbox-next aria-label="Next photo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>
</section>

<script define:vars={{ photos, base: import.meta.env.BASE_URL }}>
  function url(src) {
    return `${base}${src.replace(/^\//, '')}`;
  }

  const stage = document.querySelector('[data-stage]');
  const reel = document.querySelector('[data-reel]');
  const thumbsEl = document.querySelector('[data-thumbs]');
  const hint = document.querySelector('[data-hint]');
  const progressFill = document.querySelector('[data-progress]');
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImg = document.querySelector('[data-lightbox-img]');
  const lightboxCaption = document.querySelector('[data-lightbox-caption]');
  const lightboxCounter = document.querySelector('[data-lightbox-counter]');

  if (stage && reel && thumbsEl && lightbox && lightboxImg && lightboxCaption && lightboxCounter) {
    const panels = Array.from(reel.querySelectorAll('.reel-panel'));
    const thumbs = Array.from(thumbsEl.querySelectorAll('.reel-thumb'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover)').matches;

    const AUTOPLAY_SPEED = 0.45;
    const AUTOPLAY_DELAY = 450;
    const MAX_TILT = 18;
    const MAX_SKEW = 8;

    let currentX = 0;
    let targetX = 0;
    let maxScroll = 0;
    let activeIndex = -1;
    let hintHidden = false;
    let hoveringStage = false;
    let lastInteraction = 0;
    let autoplayDir = -1;
    let skewSmoothed = 0;
    let dragging = false;
    let dragStartX = 0;
    let dragStartTarget = 0;
    let dragMoved = false;

    function clamp(v, min, max) { return Math.min(max, Math.max(min, v)); }

    function recalc() {
      maxScroll = Math.max(0, reel.scrollWidth - stage.clientWidth);
      targetX = clamp(targetX, -maxScroll, 0);
    }

    new ResizeObserver(recalc).observe(reel);
    new ResizeObserver(recalc).observe(stage);

    function hideHint() {
      if (hintHidden || !hint) return;
      hintHidden = true;
      hint.classList.add('hide');
    }

    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      targetX = clamp(targetX - delta, -maxScroll, 0);
      lastInteraction = performance.now();
      hideHint();
    }, { passive: false });

    stage.addEventListener('mouseenter', () => { hoveringStage = true; });
    stage.addEventListener('mouseleave', () => {
      hoveringStage = false;
      lastInteraction = performance.now();
    });

    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartTarget = targetX;
      lastInteraction = performance.now();
      stage.classList.add('dragging');
    });

    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragStartX;
      // Capture only once this is a real drag, never on a plain press: a
      // capture taken at pointerdown retargets the following click to the
      // stage, so a panel's own click listener never fires and the photo
      // can't be opened.
      if (!dragMoved && Math.abs(dx) > 4) {
        dragMoved = true;
        stage.setPointerCapture(e.pointerId);
      }
      if (!dragMoved) return;
      targetX = clamp(dragStartTarget + dx, -maxScroll, 0);
      lastInteraction = performance.now();
      hideHint();
    });

    ['pointerup', 'pointercancel', 'pointerleave'].forEach((evt) => {
      stage.addEventListener(evt, () => {
        dragging = false;
        lastInteraction = performance.now();
        stage.classList.remove('dragging');
      });
    });

    function goToIndex(i) {
      const panel = panels[i];
      const target = -(panel.offsetLeft - (stage.clientWidth - panel.offsetWidth) / 2);
      targetX = clamp(target, -maxScroll, 0);
      lastInteraction = performance.now();
      hideHint();
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => goToIndex(i));
    });

    // The panels' 3D transform (rotateY/translateZ inside the preserve-3d
    // track) takes them out of hit testing entirely: pointer events land on
    // the track, so a panel's own click/pointermove listeners and its :hover
    // never fire. Everything per-panel is therefore resolved here, from the
    // post-transform rects, and driven from stage-level listeners.
    function panelAtPoint(x, y) {
      let hit = null;
      let hitDist = Infinity;
      panels.forEach((panel) => {
        const r = panel.getBoundingClientRect();
        if (x < r.left || x > r.right || y < r.top || y > r.bottom) return;
        const dist = Math.abs(x - (r.left + r.width / 2));
        if (dist < hitDist) { hitDist = dist; hit = panel; }
      });
      return hit;
    }

    let hovered = null;

    function setHovered(panel) {
      if (hovered === panel) return;
      if (hovered) {
        hovered.classList.remove('is-hovered');
        hovered.querySelector('.reel-panel__img').style.transform = 'translate(0, 0) scale(1.06)';
      }
      hovered = panel;
      if (hovered) hovered.classList.add('is-hovered');
    }

    stage.addEventListener('pointermove', (e) => {
      if (dragging) { setHovered(null); return; }
      const panel = panelAtPoint(e.clientX, e.clientY);
      setHovered(panel);
      if (!panel || !canHover || reduceMotion) return;
      const r = panel.getBoundingClientRect();
      const relX = (e.clientX - r.left) / r.width - 0.5;
      const relY = (e.clientY - r.top) / r.height - 0.5;
      panel.querySelector('.reel-panel__img').style.transform =
        `translate(${-relX * 30}px, ${-relY * 14}px) scale(1.12)`;
    });

    stage.addEventListener('pointerleave', () => setHovered(null));

    stage.addEventListener('click', (e) => {
      if (dragMoved) return;
      const panel = panelAtPoint(e.clientX, e.clientY);
      if (panel) openLightbox(panels.indexOf(panel));
    });

    // Keyboard activation targets the button directly, where `detail` is 0 —
    // pointer clicks are handled above and must not open twice.
    panels.forEach((panel, i) => {
      panel.addEventListener('click', (e) => {
        if (e.detail === 0) openLightbox(i);
      });
    });

    // Coverflow tilt/brightness touches all 37 panels' inline styles and, at
    // MAX_TILT's scale, moves too slowly per frame to need 60fps precision -
    // the ambient drift this feeds runs indefinitely (that's the point of
    // autoplay), so left uncapped this is 37 style writes forever, every
    // frame, even at rest. Throttled to every 3rd frame (~20fps): still
    // smooth for how slowly the tilt actually changes, roughly a third of
    // the main-thread cost of the version that shipped without it.
    const STACK_UPDATE_INTERVAL = 3;
    let frameCount = 0;

    // Scrolls only the horizontal thumb strip's own scroll container, never
    // the page: thumb.scrollIntoView() walks up through every scrollable
    // ancestor, including the document, so on the very first frame (when
    // activeIndex flips from -1 to 0 before the user has scrolled or
    // interacted at all) it was yanking the whole page down to the gallery.
    function centerThumb(thumb) {
      const target = thumb.offsetLeft - (thumbsEl.clientWidth - thumb.offsetWidth) / 2;
      thumbsEl.scrollTo({ left: target, behavior: 'smooth' });
    }

    function updateStack() {
      const stageCenter = stage.clientWidth / 2;
      let closest = 0;
      let closestDist = Infinity;

      panels.forEach((panel, i) => {
        const panelCenterOnScreen = panel.offsetLeft + panel.offsetWidth / 2 + currentX;
        const offset = panelCenterOnScreen - stageCenter;
        const norm = clamp(offset / stageCenter, -1, 1);

        if (!reduceMotion) {
          const angle = norm * MAX_TILT;
          const z = -Math.abs(norm) * 60;
          const scale = 1 - Math.abs(norm) * 0.08;
          const bright = 1 - Math.abs(norm) * 0.32;
          panel.style.transform = `rotateY(${angle}deg) translateZ(${z}px) scale(${scale})`;
          panel.style.filter = `brightness(${bright})`;
        }

        const dist = Math.abs(offset);
        if (dist < closestDist) { closestDist = dist; closest = i; }
      });

      if (closest !== activeIndex) {
        activeIndex = closest;
        thumbs.forEach((t, i) => t.classList.toggle('active', i === activeIndex));
        centerThumb(thumbs[activeIndex]);
      }
      if (progressFill) {
        progressFill.style.width = maxScroll > 0 ? `${(-currentX / maxScroll) * 100}%` : '0%';
      }
    }

    // Position and skew are one style write and need every frame to look
    // smooth at drag/autoplay speed, so they stay uncoupled from the
    // throttled panel pass above.
    function updateReel(velocity) {
      const targetSkew = reduceMotion ? 0 : clamp(velocity * -0.7, -MAX_SKEW, MAX_SKEW);
      skewSmoothed += (targetSkew - skewSmoothed) * 0.25;
      reel.style.transform = `translate3d(${currentX}px, 0, 0) skewX(${skewSmoothed}deg)`;
    }

    function frame() {
      const now = performance.now();
      if (!dragging && !hoveringStage && !reduceMotion && now - lastInteraction > AUTOPLAY_DELAY) {
        targetX += autoplayDir * AUTOPLAY_SPEED;
        if (targetX <= -maxScroll) { targetX = -maxScroll; autoplayDir = 1; }
        else if (targetX >= 0) { targetX = 0; autoplayDir = -1; }
      }

      const prevX = currentX;
      currentX += (targetX - currentX) * (reduceMotion ? 1 : 0.14);
      updateReel(currentX - prevX);

      frameCount++;
      if (reduceMotion || frameCount % STACK_UPDATE_INTERVAL === 0) {
        updateStack();
      }
      requestAnimationFrame(frame);
    }

    requestAnimationFrame(() => {
      recalc();
      frame();
    });

    window.addEventListener('resize', recalc);

    let lightboxIdx = 0;

    function openLightbox(idx) {
      lightboxIdx = idx;
      const p = photos[idx];
      lightboxImg.src = url(p.src);
      lightboxImg.alt = p.caption;
      lightboxCaption.textContent = p.caption;
      lightboxCounter.textContent = `${idx + 1} / ${photos.length}`;
      lightbox.hidden = false;
    }

    function closeLightbox() {
      lightbox.hidden = true;
    }

    function stepLightbox(delta) {
      openLightbox((lightboxIdx + delta + photos.length) % photos.length);
    }

    document.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
    document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => stepLightbox(-1));
    document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => stepLightbox(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') stepLightbox(-1);
      else if (e.key === 'ArrowRight') stepLightbox(1);
    });
  }
</script>

<style>
  .gallery {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--surface);
    position: relative;
  }

  .gallery__head {
    margin-bottom: 1.6rem;
  }

  .gallery__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 0;
  }

  .reel-stage {
    position: relative;
    height: clamp(260px, 42vh, 420px);
    background: var(--bg);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    border-block: 1px solid var(--staff-line-strong);
    perspective: 1400px;
  }

  .reel-stage.dragging {
    cursor: grabbing;
  }

  .reel-track {
    position: absolute;
    inset-block: 0;
    left: 0;
    display: flex;
    align-items: stretch;
    gap: 10px;
    padding-inline: max(20px, calc((100vw - 1180px) / 2 + 20px));
    will-change: transform;
    transform-style: preserve-3d;
  }

  .reel-panel {
    position: relative;
    flex: 0 0 auto;
    width: clamp(240px, 23vw, 336px);
    height: 100%;
    padding: 0;
    border: none;
    overflow: hidden;
    border-radius: 3px;
    background: var(--bg-elevated);
    cursor: pointer;
    will-change: transform, filter;
  }

  .reel-panel__img {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    transform: translate(0, 0) scale(1.06);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    user-select: none;
  }

  .reel-panel__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.7rem 0.6rem;
    background: linear-gradient(180deg, transparent, rgba(10, 14, 23, 0.92) 88%);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    text-align: left;
  }

  .reel-panel.is-hovered .reel-panel__caption,
  .reel-panel:focus-visible .reel-panel__caption {
    opacity: 1;
    transform: translateY(0);
  }

  .reel-panel__caption span {
    display: block;
    font-size: 0.7rem;
    color: var(--text);
    line-height: 1.3;
  }

  .reel-panel__index {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    color: var(--brass);
    margin-top: 0.15rem;
  }

  .reel-hint {
    position: absolute;
    top: 12px;
    right: max(20px, calc((100vw - 1180px) / 2 + 20px));
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(10, 14, 23, 0.65);
    border: 1px solid var(--staff-line-strong);
    border-radius: 999px;
    padding: 0.4rem 0.7rem;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 3;
  }

  .reel-hint.hide {
    opacity: 0;
  }

  .gallery__filmstrip {
    padding-top: 0.9rem;
  }

  .reel-thumbs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 0.2rem;
  }

  .reel-thumbs::-webkit-scrollbar {
    display: none;
  }

  .reel-thumb {
    flex: 0 0 auto;
    width: 46px;
    height: 58px;
    padding: 0;
    border: 1px solid var(--staff-line-strong);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-elevated);
    cursor: pointer;
    opacity: 0.5;
    transform: translateY(0);
    transition: opacity 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .reel-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reel-thumb:hover {
    opacity: 0.8;
  }

  .reel-thumb.active {
    opacity: 1;
    border-color: var(--brass);
    transform: translateY(-3px);
  }

  .reel-progress {
    height: 2px;
    background: var(--staff-line-strong);
    margin-top: 0.6rem;
    border-radius: 2px;
    overflow: hidden;
  }

  .reel-progress__fill {
    height: 100%;
    width: 0%;
    background: var(--brass);
  }

  @media (max-width: 480px) {
    .reel-panel {
      width: 60vw;
    }
  }

  .gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(6, 8, 13, 0.94);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__lightbox[hidden] {
    display: none;
  }

  .gallery__lightbox-content {
    max-width: min(80vw, 900px);
    max-height: 82vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .gallery__lightbox-content img {
    max-width: 100%;
    max-height: 68vh;
    object-fit: contain;
    border-radius: 4px;
  }

  .gallery__lightbox-caption {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .gallery__lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: var(--text);
    cursor: pointer;
    padding: 0.5rem;
  }

  .gallery__lightbox-counter {
    position: absolute;
    top: 1.6rem;
    left: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .gallery__lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text);
    cursor: pointer;
    padding: 0.75rem;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .gallery__lightbox-nav:hover,
  .gallery__lightbox-nav:focus-visible {
    opacity: 1;
  }

  .gallery__lightbox-nav--prev {
    left: clamp(0.5rem, 3vw, 2rem);
  }

  .gallery__lightbox-nav--next {
    right: clamp(0.5rem, 3vw, 2rem);
  }
</style>
