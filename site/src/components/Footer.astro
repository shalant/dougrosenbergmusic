---
// Composed out of two things that used to live buried inside Contact.astro:
// the social links (previously sandwiched awkwardly between the email CTA
// and the "or send a message directly" form) and the site's own case-study
// credit line + copyright (previously a bare two-line <footer> nested
// inside the #contact section rather than a real page-level landmark).
//
// Icons since 2026-10-18 (Doug prefers them to text labels), Lucide-style
// strokes to match the nav and dividers. The developer site sits in the row
// too, as a cross-link, with the same </> mark and red as the nav's DEV note.
const socials = [
  {
    label: 'Instagram',
    href: 'https://instagram.com/shalantdoro',
    icon: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  },
  {
    label: 'YouTube',
    href: 'https://youtube.com/@dougrosenberg2361',
    icon: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/douglasrosenberg',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/shalant',
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    label: 'Developer site: dougrosenbergdev.com',
    href: 'https://dougrosenbergdev.com',
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
    dev: true,
  },
];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__name">
      <a href="https://dougrosenbergdev.com" target="_blank" rel="noopener noreferrer">Doug Rosenberg</a>
    </p>

    <nav class="site-footer__socials" aria-label="Social links">
      {socials.map((s) => (
        <a class:list={['site-footer__social', { 'site-footer__social--dev': s.dev }]} href={s.href} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
          <span class="visually-hidden">{s.label} (opens in a new tab)</span>
        </a>
      ))}
    </nav>

    <p class="site-footer__proof">
      This site — Astro, Cloudflare Workers, no bloat — is the portfolio. <a href="https://dougrosenbergdev.com/blog/rebuilding-musician-site-blazor-to-astro/" target="_blank" rel="noopener noreferrer">See how it was rebuilt →</a>
    </p>

    <p class="site-footer__copyright">© {new Date().getFullYear()} Doug Rosenberg</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #060810;
    border-top: 1px solid rgba(233, 237, 245, 0.08);
    padding-block: clamp(2.5rem, 6vw, 3.5rem) clamp(1.75rem, 4vw, 2.25rem);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--text);
    margin: 0;
  }

  /* Byline links to dougrosenbergdev.com - underlined by default rather
     than relying on color alone, same axe link-in-text-block reasoning
     already applied to .site-footer__proof below. */
  .site-footer__name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(233, 237, 245, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-base) ease, color var(--dur-base) ease;
    /* 44px tap target: padding grows it, negative margin cancels the
       layout footprint - measured 23px tall before. */
    display: inline-block;
    padding-block: 0.75rem;
    margin-block: -0.75rem;
  }

  .site-footer__name a:hover,
  .site-footer__name a:focus-visible {
    color: var(--glow);
    text-decoration-color: currentColor;
  }

  .site-footer__socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* 44px round icon buttons: a real tap target without the padding trick
     the old text links needed. Each is named by its visually hidden label. */
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(233, 237, 245, 0.14);
    color: var(--text-muted);
    transition: color var(--dur-base) ease, border-color var(--dur-base) ease, background-color var(--dur-base) ease, translate var(--dur-med) var(--ease-spring);
  }

  .site-footer__social svg {
    width: 20px;
    height: 20px;
  }

  .site-footer__social:hover,
  .site-footer__social:focus-visible {
    color: var(--text);
    border-color: var(--brass);
    background-color: var(--brass-soft);
  }

  .site-footer__social--dev {
    color: var(--note-dev);
    border-color: rgba(224, 95, 106, 0.4);
  }

  .site-footer__social--dev:hover,
  .site-footer__social--dev:focus-visible {
    color: var(--text);
    border-color: var(--note-dev);
    background-color: rgba(224, 95, 106, 0.16);
  }

  .site-footer__social:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6);
    translate: 0 -2px;
  }

  /* Hover lift only where hover is real (see global.css); taps press in. */
  @media (hover: hover) {
    .site-footer__social:hover {
      translate: 0 -2px;
    }
  }

  .site-footer__social:active {
    translate: 0 0;
    scale: 0.94;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__social {
      transition: none;
    }

    .site-footer__social:hover,
    .site-footer__social:focus-visible,
    .site-footer__social:active {
      translate: none;
      scale: none;
    }
  }

  .site-footer__proof {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  /* This link sits inline in a sentence of body text - color alone (green
     link vs. muted gray prose) isn't enough to mark it as a link (axe's
     link-in-text-block rule, confirmed via a real Lighthouse CI failure).
     Underlined by default now, not just on hover/focus. */
  .site-footer__proof a {
    color: var(--glow);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--dur-base) ease;
  }

  .site-footer__proof a:hover,
  .site-footer__proof a:focus-visible {
    color: #9fe8cd;
  }

  .site-footer__copyright {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
</style>
