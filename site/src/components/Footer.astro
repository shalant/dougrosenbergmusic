---
// "Liner notes" footer (2026-10-18), picked from five footer concepts kept in
// ui-lab (artifacts/dougrosenbergmusic/footer-redesigns/). Laid out like an
// album back cover: Side A is this page's sections, Side B the cross-links
// (archive, press, the developer site, the rebuild write-up), Personnel the
// social icons plus a credits line built from the About tags.
//
// Socials are icons since 2026-10-18 (Doug prefers them to text labels),
// Lucide-style strokes to match the nav and dividers. The developer site sits
// in that row too, with the same </> mark and red as the nav's DEV note.
const sideA = [
  { label: 'Dev', href: '#dev' },
  { label: 'Listen', href: '#listen' },
  { label: 'About', href: '#about' },
  { label: 'Highlights', href: '#career-highlights' },
  { label: 'Lessons', href: '#lessons' },
  { label: 'Contact', href: '#contact' },
];

const socials = [
  {
    label: 'Instagram',
    href: 'https://instagram.com/shalantdoro',
    icon: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  },
  {
    label: 'YouTube',
    href: 'https://youtube.com/@dougrosenberg2361',
    icon: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/douglasrosenberg',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/shalant',
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    label: 'Developer site: dougrosenbergdev.com',
    href: 'https://dougrosenbergdev.com',
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
    dev: true,
  },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<footer class="site-footer">
  <div class="wrap">
    <div class="liner">
      <div class="liner__head">
        <p class="liner__name">Doug Rosenberg</p>
        <p class="liner__kicker">Liner notes · dougrosenbergmusic.com</p>
      </div>

      <div class="liner__cols">
        <nav class="liner__col" aria-label="On this page">
          <p class="liner__label">Side A · This page</p>
          <ol class="liner__tracks">
            {sideA.map((t, i) => (
              <li>
                <a class="liner__track" href={t.href}>
                  <span class="liner__num" aria-hidden="true">{num(i)}</span>
                  <span class="liner__title">{t.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <nav class="liner__col" aria-label="More from Doug">
          <p class="liner__label">Side B · Bonus tracks</p>
          <ol class="liner__tracks" start="7">
            <li>
              <a class="liner__track" href="/easternblok">
                <span class="liner__num" aria-hidden="true">07</span>
                <span class="liner__title">Eastern Blok archive</span>
              </a>
            </li>
            <li>
              <a class="liner__track" href="/press">
                <span class="liner__num" aria-hidden="true">08</span>
                <span class="liner__title">All press</span>
              </a>
            </li>
            <li>
              <a class="liner__track liner__track--dev" href="https://dougrosenbergdev.com" target="_blank" rel="noopener noreferrer">
                <span class="liner__num" aria-hidden="true">09</span>
                <span class="liner__title">
                  Want a site like this one?
                  <span class="liner__sub">dougrosenbergdev.com <span aria-hidden="true">↗</span></span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </span>
              </a>
            </li>
            <li>
              <a class="liner__track" href="https://dougrosenbergdev.com/blog/rebuilding-musician-site-blazor-to-astro/" target="_blank" rel="noopener noreferrer">
                <span class="liner__num" aria-hidden="true">10</span>
                <span class="liner__title">
                  How this site was rebuilt <span aria-hidden="true">↗</span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </span>
              </a>
            </li>
          </ol>
        </nav>

        <div class="liner__col">
          <p class="liner__label">Personnel · Find me</p>
          <nav class="site-footer__socials" aria-label="Social links">
            {socials.map((s) => (
              <a class:list={['site-footer__social', { 'site-footer__social--dev': s.dev }]} href={s.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
                <span class="visually-hidden">{s.label} (opens in a new tab)</span>
              </a>
            ))}
          </nav>
          <p class="liner__credits">
            <span class="liner__credit-name">Doug Rosenberg</span>: saxophones, flutes, clarinets; composition and arranging.<br />
            <span class="liner__credit-name">Also Doug Rosenberg</span>: design and code. This site is the portfolio: Astro, Cloudflare Workers, no bloat.
          </p>
        </div>
      </div>

      <div class="liner__foot">
        <p class="site-footer__copyright">© {new Date().getFullYear()} Doug Rosenberg. All rights reserved.</p>
        <a class="liner__top" href="#hero">Back to top <span class="liner__top-arrow" aria-hidden="true">↑</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #060810;
    border-top: 1px solid rgba(233, 237, 245, 0.08);
    padding-block: clamp(1.5rem, 5vw, 2.5rem);
  }

  /* The sleeve: one brass hairline frame around the whole footer. */
  .liner {
    border: 1px solid rgba(207, 154, 79, 0.35);
    padding: clamp(1.25rem, 4vw, 2.25rem) clamp(1rem, 4vw, 2.75rem) clamp(1rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 1.75rem);
  }

  .liner__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(233, 237, 245, 0.1);
  }

  .liner__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 4vw, 1.9rem);
    color: var(--text);
  }

  .liner__kicker,
  .liner__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .liner__kicker {
    color: var(--brass);
  }

  .liner__label {
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }

  .liner__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 3rem;
  }

  .liner__tracks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .liner__track {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 2rem;
    padding-block: 0.2rem;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .liner__num {
    flex: none;
    width: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    transition: color var(--dur-base) ease;
  }

  .liner__title {
    transition: color var(--dur-base) ease, translate var(--dur-med) var(--ease-out);
  }

  .liner__track--dev {
    align-items: flex-start;
    padding-block: 0.45rem;
  }

  .liner__track--dev .liner__num {
    color: rgba(224, 95, 106, 0.75);
    padding-top: 0.15rem;
  }

  .liner__sub {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--note-dev);
  }

  .liner__track:hover .liner__num,
  .liner__track:focus-visible .liner__num {
    color: var(--brass);
  }

  .liner__track:hover .liner__title,
  .liner__track:focus-visible .liner__title {
    color: var(--brass);
  }

  .liner__track--dev:hover .liner__title,
  .liner__track--dev:focus-visible .liner__title {
    color: var(--text);
  }

  .liner__track:focus-visible,
  .liner__top:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.6);
    outline-offset: 2px;
  }

  .liner__track:focus-visible .liner__title {
    translate: 4px 0;
  }

  /* Tracks nudge right, not padding-left: no reflow (see global.css). */
  @media (hover: hover) {
    .liner__track:hover .liner__title {
      translate: 4px 0;
    }
  }

  /* Phone: full-height tap rows. */
  @media (pointer: coarse) {
    .liner__track {
      min-height: 2.75rem;
    }
  }

  .liner__credits {
    margin: 1.1rem 0 0;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .liner__credit-name {
    color: var(--text);
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* 44px round icon buttons, each named by its visually hidden label. */
  .site-footer__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(233, 237, 245, 0.18);
    color: var(--text-muted);
    transition: color var(--dur-base) ease, border-color var(--dur-base) ease, background-color var(--dur-base) ease, translate var(--dur-med) var(--ease-spring);
  }

  .site-footer__social svg {
    width: 20px;
    height: 20px;
  }

  .site-footer__social:hover,
  .site-footer__social:focus-visible {
    color: var(--text);
    border-color: var(--brass);
    background-color: var(--brass-soft);
  }

  /* The developer site is the one filled note in the row. */
  .site-footer__social--dev {
    color: #0a0e17;
    border-color: var(--note-dev);
    background-color: var(--note-dev);
  }

  .site-footer__social--dev:hover,
  .site-footer__social--dev:focus-visible {
    color: #0a0e17;
    border-color: #ec8890;
    background-color: #ec8890;
  }

  .site-footer__social:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.6);
    translate: 0 -2px;
  }

  /* Hover lift only where hover is real (see global.css); taps press in. */
  @media (hover: hover) {
    .site-footer__social:hover {
      translate: 0 -2px;
    }
  }

  .site-footer__social:active {
    translate: 0 0;
    scale: 0.94;
  }

  .liner__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }

  .site-footer__copyright {
    margin: 0;
    color: var(--text-faint);
  }

  .liner__top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color var(--dur-base) ease;
  }

  .liner__top:hover,
  .liner__top:focus-visible {
    color: var(--brass);
  }

  .liner__top-arrow {
    transition: translate var(--dur-med) var(--ease-spring);
  }

  .liner__top:focus-visible .liner__top-arrow {
    translate: 0 -3px;
  }

  @media (hover: hover) {
    .liner__top:hover .liner__top-arrow {
      translate: 0 -3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__social,
    .liner__title,
    .liner__top-arrow {
      transition: none;
    }

    .site-footer__social:hover,
    .site-footer__social:focus-visible,
    .site-footer__social:active,
    .liner__track .liner__title,
    .liner__top .liner__top-arrow {
      translate: none !important;
      scale: none;
    }
  }

  /* Tablet: the two sides pair up, Personnel spans below them. */
  @media (max-width: 900px) {
    .liner__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .liner__cols > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .liner__cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
