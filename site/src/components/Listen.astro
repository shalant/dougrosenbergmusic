---
import { getPlayable } from '../lib/playable-tracks.js';

// "Hear it" (2026-11-22): the tracks Doug put on the site, in full, as a plain
// list. It appears only when the audio files exist, and it drives the same
// player as the hero's sax bell (BellPlayer.astro) through window events, so
// there is one player bar and one source of truth for what is playing.
const hear = getPlayable(import.meta.env.BASE_URL);
const count = ['', 'One', 'Two', 'Three', 'Four', 'Five'][hear.tracks.length] ?? String(hear.tracks.length);

const albums = [
  {
    title: 'Better Than TV',
    cover: '/images/albums/better-than-tv.jpg',
    blurb: '2014 debut. "Fearlessness of spirit and a robustness of tone" — Chicago Tribune.',
    url: 'https://www.amazon.com/dp/B00G9Y8TPE',
  },
  {
    title: 'Goran Ivanovic Group',
    cover: '/images/albums/goran-ivanovic-group.jpg',
    blurb: 'Balkan folk and acoustic jazz, with the zesty odd-metered rhythms of Eastern European folk music.',
    url: 'https://www.amazon.com/Goran-Ivanovic-Group/dp/B000HWY64C',
  },
  {
    title: 'Underwater',
    cover: '/images/albums/underwater.jpg',
    blurb: 'With Eastern Blok — foreign and familiar, patient and strange.',
    url: 'https://www.amazon.com/dp/B006HTEKHM',
  },
  {
    title: 'Folk Tales',
    cover: '/images/albums/folk-tales.jpg',
    blurb: "Eastern Blok's sophomore release — somber and serious, lively and elusive.",
    url: 'https://www.amazon.com/dp/B00169L616',
  },
];
---

<section id="listen" class="listen staff-lines">
  <div class="wrap">
    <h2 class="listen__heading heading-reveal">Recordings</h2>

    {
      hear.tracks.length > 0 && (
        <div class="hear">
          <div class="hear__intro">
            <h3 class="hear__title">Hear it</h3>
            <p class="hear__blurb">
              {count} {hear.tracks.length === 1 ? 'track' : 'tracks'} from <em>{hear.album}</em>, in full.
            </p>
            <a class="hear__buy" href={hear.buyUrl} target="_blank" rel="noopener noreferrer" data-cta="listen-buy">
              Get the album <span aria-hidden="true">&rarr;</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
          <ol class="hear__list">
            {hear.tracks.map((t, i) => (
              <li>
                <button type="button" class="hear__row" data-track={i} data-name={t.title} data-length={t.length} data-cta="listen-track" aria-label={`Play ${t.title}${t.length ? `, ${t.length}` : ''}`}>
                  <span class="hear__btn" aria-hidden="true">
                    <svg class="hear__i-play" viewBox="0 0 16 16" fill="currentColor" focusable="false"><path d="M4.5 2.5v11l9-5.5z" /></svg>
                    <svg class="hear__i-pause" viewBox="0 0 16 16" fill="currentColor" focusable="false"><path d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
                  </span>
                  <span class="hear__name">{t.title}</span>
                  {t.length && <span class="hear__time">{t.length}</span>}
                </button>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    <div class="listen__grid">
      {albums.map((album, i) => (
        <a class={i === 0 ? 'album album--lead scroll-rise' : 'album scroll-rise'} style={`--i:${i}`} href={album.url} target="_blank" rel="noopener noreferrer">
          <span class="album__art"><img class="album__cover" src={`${import.meta.env.BASE_URL}${album.cover.replace(/^\//, '')}`} alt={`${album.title} album cover`} loading="lazy" /></span>
          <div class="album__body">
            <h3 class="album__title">{album.title}</h3>
            <p class="album__blurb">{album.blurb}</p>
            <span class="album__cue" aria-hidden="true">Listen on Amazon &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .listen {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: transparent;
  }

  .listen__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 2.5rem;
  }

  .listen__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  /* Records on a shelf, not cards (2026-10-25): the cover sits straight on
     the page with its title and blurb under it. Four identical rounded,
     tinted cards were one of the template tells in the UI assessment. The
     hover/focus accent moved from the card's border to the cover's own
     outline. */
  .album {
    display: block;
    text-decoration: none;
    color: var(--text);
    border-radius: 3px;
    transition: transform var(--dur-base) ease;
  }

  .album__art {
    display: block;
    overflow: hidden;
    border-radius: 3px;
    outline: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    outline-offset: -1px;
    box-shadow: 0 14px 30px -18px color-mix(in srgb, var(--shadow) 90%, transparent);
    transition: outline-color var(--dur-base) ease;
  }

  .album:hover .album__art,
  .album:focus-visible .album__art {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .album:focus-visible {
    transform: translateY(-3px);
  }

  .album__cover {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: scale var(--dur-slow) var(--ease-out);
  }

  /* The cover pushes in slightly inside its frame on hover (the card's
     overflow: hidden crops it), and the card settles back down when
     pressed (2026-10-17). */
  .album:focus-visible .album__cover {
    scale: 1.04;
  }

  /* Hover movement only where hover is real (see global.css): on a phone
     the tapped card would otherwise stay lifted after you come back. */
  @media (hover: hover) {
    .album:hover {
      transform: translateY(-3px);
    }

    .album:hover .album__cover {
      scale: 1.04;
    }
  }

  .album:active {
    transform: translateY(0) scale(0.99);
  }

  /* The records arrive one after another as you scroll (.scroll-rise,
     global.css): the lead first, each of the others a beat later. Unlike the
     shared reveal they also grow from 0.95: they are pictures, and nothing
     measures or focuses inside them. */
  .album {
    --rise-range: entry calc(var(--i) * 7%) entry calc(70% + var(--i) * 6%);
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    @supports (animation-timeline: view()) {
      .album.scroll-rise {
        animation-name: album-scroll-rise;
      }
    }
  }

  @keyframes album-scroll-rise {
    from {
      opacity: 0;
      translate: 0 2.75rem;
      scale: 0.95;
    }
    to {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }
  }

  /* Pick-up tilt (2026-11-17): on a real pointer the cover turns toward the
     cursor like a sleeve held in the hand, with a soft light that follows
     it. The script below only writes --tx/--ty (-0.5 to 0.5, from the cover's
     center) and --gx/--gy (0 to 1); everything visible is CSS. No loop, and
     it settles flat when the pointer leaves. Placed after the hover and
     press rules so it wins over them. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .album__art {
      position: relative;
      transform: perspective(800px) rotateX(calc(var(--ty, 0) * -10deg)) rotateY(calc(var(--tx, 0) * 10deg));
      transition:
        outline-color var(--dur-base) ease,
        transform var(--dur-med) var(--ease-out),
        box-shadow var(--dur-med) ease;
    }

    .album__art::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(
        circle at calc(var(--gx, 0.5) * 100%) calc(var(--gy, 0.5) * 100%),
        rgba(255, 255, 255, 0.3),
        transparent 55%
      );
      opacity: 0;
      transition: opacity var(--dur-med) ease;
    }

    .album:hover .album__art {
      box-shadow: 0 30px 44px -20px color-mix(in srgb, var(--shadow) 95%, transparent);
    }

    .album:hover .album__art::after {
      opacity: 1;
    }

    .album:active .album__art {
      transform: perspective(800px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .album,
    .album__cover {
      transition: none;
    }
    .album:hover,
    .album:focus-visible,
    .album:active {
      transform: none;
    }
    .album:hover .album__cover,
    .album:focus-visible .album__cover {
      scale: none;
    }
  }

  .album__body {
    padding: 0.9rem 0.1rem 0;
  }

  /* Doug's own record leads (2026-11-01): four identical squares were the
     page's stock grid. From 760px the debut gets a wider column, so a bigger
     cover and a larger title, and the three group records sit beside it.
     Below that the original even grid and the phone rows apply unchanged. */
  /* The three group records stack as rows beside the lead (2026-11-01, second
     pass): in one 4-column row the tall lead left about 250px of empty space
     under the other three. Two columns of about equal height close it. */
  @media (min-width: 760px) {
    .listen__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: repeat(3, auto);
      align-content: start;
      align-items: start;
    }
    .album--lead {
      grid-row: 1 / span 3;
    }
    .album:not(.album--lead) {
      display: grid;
      grid-template-columns: clamp(120px, 18vw, 190px) minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }
    /* The text column is as tall as its cover (2026-11-19): title and blurb
       at the top, the listen cue on the cover's bottom edge. Short blurbs next
       to a 190px cover used to leave a hollow under them. */
    .album:not(.album--lead) .album__body {
      padding-top: 0.15rem;
      align-self: stretch;
      display: flex;
      flex-direction: column;
    }
    .album:not(.album--lead) .album__title {
      font-size: 1.3rem;
    }
    .album:not(.album--lead) .album__blurb {
      font-size: 0.95rem;
    }
    .album__cue {
      display: block;
      margin-top: auto;
      padding-top: 0.75rem;
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--brass);
    }
    .album--lead .album__cue {
      margin-top: 0.75rem;
    }
    .album--lead .album__title {
      font-size: 1.5rem;
    }
    .album--lead .album__blurb {
      font-size: 0.95rem;
    }
  }

  /* The listen cue is for the wide rows only; the compact rows below 760px skip it. */
  @media (max-width: 759px) {
    .album__cue {
      display: none;
    }
  }

  .album__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  .album__blurb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* On a phone the four full-width cards ran to about four screens before
     About (2026-10-16 audit). Each becomes a row: a small cover beside its
     title and blurb, about a quarter of the height. */
  @media (max-width: 520px) {
    .listen__grid {
      gap: 0.9rem;
    }
    .album {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: center;
    }
    .album__body {
      padding: 0 0 0 0.95rem;
    }
    .album__blurb {
      font-size: 0.875rem;
    }
  }

  /* ---- "Hear it": the track list ---- */
  .hear {
    display: grid;
    gap: 1.2rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 760px) {
    .hear {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
      align-items: start;
    }
  }

  .hear__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--brass);
  }

  .hear__blurb {
    margin: 0 0 0.9rem;
    max-width: 30ch;
    color: var(--text-muted);
  }

  .hear__buy {
    display: inline-block;
    padding-block: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brass);
    text-underline-offset: 4px;
  }

  .hear__buy:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .hear__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--staff-line-strong);
  }

  .hear__list li {
    border-top: 1px solid var(--staff-line-strong);
  }

  .hear__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 4rem;
    padding: 0.6rem 0.25rem;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .hear__row:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .hear__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--brass);
    border-radius: 50%;
    color: var(--brass);
    transition: background-color var(--dur-base) ease, color var(--dur-base) ease;
  }

  .hear__btn svg {
    width: 1rem;
    height: 1rem;
  }

  .hear__i-pause {
    display: none;
  }

  .hear__name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.2;
    transition: color var(--dur-base) ease;
  }

  .hear__time {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (hover: hover) {
    .hear__row:hover .hear__btn {
      background: var(--brass-soft);
    }
    .hear__row:hover .hear__name {
      color: var(--brass);
    }
  }

  .hear__row.is-current .hear__name {
    color: var(--brass);
  }

  .hear__row[data-playing] .hear__btn {
    background: var(--brass);
    color: var(--bg);
  }

  .hear__row[data-playing] .hear__i-play {
    display: none;
  }

  .hear__row[data-playing] .hear__i-pause {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hear__btn,
    .hear__name {
      transition: none;
    }
  }
</style>

<script>
  // Pick-up tilt for the album covers (2026-11-17): writes the pointer's
  // place over the cover into CSS variables; the Listen styles do the rest.
  // Only for a real pointer, never under reduced motion, and not on a weak
  // device (the hero script sets data-fx="lite" there).
  const canTilt = matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canTilt) {
    document.querySelectorAll<HTMLElement>('.album').forEach((album) => {
      const art = album.querySelector<HTMLElement>('.album__art');
      if (!art) return;
      album.addEventListener('pointermove', (e) => {
        if (document.documentElement.dataset.fx === 'lite') return;
        const r = art.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        album.style.setProperty('--tx', String(x - 0.5));
        album.style.setProperty('--ty', String(y - 0.5));
        album.style.setProperty('--gx', String(x));
        album.style.setProperty('--gy', String(y));
      });
      album.addEventListener('pointerleave', () => {
        for (const v of ['--tx', '--ty', '--gx', '--gy']) album.style.removeProperty(v);
      });
    });
  }
</script>

<script>
  // "Hear it": a press on a track asks the bell player (BellPlayer.astro) to play or
  // pause it; the player answers with which track is current and whether it plays.
  const rows = document.querySelectorAll<HTMLButtonElement>('.hear__row');
  if (rows.length) {
    rows.forEach((row) =>
      row.addEventListener('click', () => window.dispatchEvent(new CustomEvent('bellp:play', { detail: { index: Number(row.dataset.track) } }))),
    );
    window.addEventListener('bellp:state', (e) => {
      const { index, playing } = (e as CustomEvent<{ index: number; playing: boolean }>).detail;
      rows.forEach((row) => {
        const current = Number(row.dataset.track) === index;
        const on = current && playing;
        row.classList.toggle('is-current', current);
        if (on) row.setAttribute('data-playing', '');
        else row.removeAttribute('data-playing');
        row.setAttribute('aria-label', `${on ? 'Pause' : 'Play'} ${row.dataset.name}${row.dataset.length ? `, ${row.dataset.length}` : ''}`);
      });
    });
  }
</script>
