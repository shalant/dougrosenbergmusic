---
const albums = [
  {
    title: 'Better Than TV',
    cover: '/images/albums/better-than-tv.jpg',
    blurb: '2014 debut. "Fearlessness of spirit and a robustness of tone" — Chicago Tribune.',
    url: 'https://www.amazon.com/dp/B00G9Y8TPE',
  },
  {
    title: 'Goran Ivanovic Group',
    cover: '/images/albums/goran-ivanovic-group.jpg',
    blurb: 'Balkan folk and acoustic jazz, with the zesty odd-metered rhythms of Eastern European folk music.',
    url: 'https://www.amazon.com/Goran-Ivanovic-Group/dp/B000HWY64C',
  },
  {
    title: 'Underwater',
    cover: '/images/albums/underwater.jpg',
    blurb: 'With Eastern Blok — foreign and familiar, patient and strange.',
    url: 'https://www.amazon.com/dp/B006HTEKHM',
  },
  {
    title: 'Folk Tales',
    cover: '/images/albums/folk-tales.jpg',
    blurb: "Eastern Blok's sophomore release — somber and serious, lively and elusive.",
    url: 'https://www.amazon.com/dp/B00169L616',
  },
];
---

<section id="listen" class="listen staff-lines">
  <div class="wrap">
    <h2 class="listen__heading">Recordings</h2>

    <div class="listen__grid">
      {albums.map((album) => (
        <a class="album" href={album.url} target="_blank" rel="noopener noreferrer">
          <span class="album__art"><img class="album__cover" src={`${import.meta.env.BASE_URL}${album.cover.replace(/^\//, '')}`} alt={`${album.title} album cover`} loading="lazy" /></span>
          <div class="album__body">
            <h3 class="album__title">{album.title}</h3>
            <p class="album__blurb">{album.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .listen {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--bg);
  }

  .listen__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0.3rem 0 2.5rem;
  }

  .listen__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  /* Records on a shelf, not cards (2026-10-25): the cover sits straight on
     the page with its title and blurb under it. Four identical rounded,
     tinted cards were one of the template tells in the UI assessment. The
     hover/focus accent moved from the card's border to the cover's own
     outline. */
  .album {
    display: block;
    text-decoration: none;
    color: var(--text);
    border-radius: 3px;
    transition: transform var(--dur-base) ease;
  }

  .album__art {
    display: block;
    overflow: hidden;
    border-radius: 3px;
    outline: 1px solid rgba(233, 237, 245, 0.1);
    outline-offset: -1px;
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.9);
    transition: outline-color var(--dur-base) ease;
  }

  .album:hover .album__art,
  .album:focus-visible .album__art {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .album:focus-visible {
    transform: translateY(-3px);
  }

  .album__cover {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: scale var(--dur-slow) var(--ease-out);
  }

  /* The cover pushes in slightly inside its frame on hover (the card's
     overflow: hidden crops it), and the card settles back down when
     pressed (2026-10-17). */
  .album:focus-visible .album__cover {
    scale: 1.04;
  }

  /* Hover movement only where hover is real (see global.css): on a phone
     the tapped card would otherwise stay lifted after you come back. */
  @media (hover: hover) {
    .album:hover {
      transform: translateY(-3px);
    }

    .album:hover .album__cover {
      scale: 1.04;
    }
  }

  .album:active {
    transform: translateY(0) scale(0.99);
  }

  @media (prefers-reduced-motion: reduce) {
    .album,
    .album__cover {
      transition: none;
    }
    .album:hover,
    .album:focus-visible,
    .album:active {
      transform: none;
    }
    .album:hover .album__cover,
    .album:focus-visible .album__cover {
      scale: none;
    }
  }

  .album__body {
    padding: 0.9rem 0.1rem 0;
  }

  .album__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  .album__blurb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* On a phone the four full-width cards ran to about four screens before
     About (2026-10-16 audit). Each becomes a row: a small cover beside its
     title and blurb, about a quarter of the height. */
  @media (max-width: 520px) {
    .listen__grid {
      gap: 0.9rem;
    }
    .album {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: center;
    }
    .album__body {
      padding: 0 0 0 0.95rem;
    }
    .album__blurb {
      font-size: 0.8rem;
    }
  }
</style>
