---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import StaffNav from '../components/StaffNav.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${import.meta.env.BASE_URL}images/og-image.jpg`, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Doug Rosenberg',
  jobTitle: ['Web Developer', 'Saxophonist', 'Composer', 'Educator'],
  url: Astro.site?.toString(),
  email: 'mailto:doug.rosenberg@gmail.com',
  sameAs: [
    'https://dougrosenbergdev.com',
    'https://instagram.com/shalantdoro',
    'https://youtube.com/@dougrosenberg2361',
    'https://linkedin.com/in/douglasrosenberg',
    'https://github.com/shalant',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Doug Rosenberg',
  url: Astro.site?.toString(),
  description: 'Doug Rosenberg — web design and development, plus a saxophonist, composer, and educator. Recordings, performance history, teaching credentials, and a sheet music library for private students.',
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

		<!-- Cloudflare Web Analytics — chosen over GA4/Plausible for zero-config,
		     no-cookie-consent-overhead reasons, same as haxbyte.com. Token isn't a
		     secret; it's a public per-site beacon ID meant to ship in every page's
		     HTML. Site registered under Web Analytics as
		     dougrosenbergmusic.doug-rosenberg.workers.dev. -->
		<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: '775b11737d154a3a8878533ba375f9f9' })}></script>

		<!-- GA4 — reinstalled 2026-09-15; the property (G-BGSJ1FWPTF) existed but
		     had no tag on the current Astro build, so it collected nothing since
		     the rebuild.
		     Consent Mode v2 default is 'denied' for every storage type below,
		     and there's no consent-collection UI on this site to ever grant it -
		     this keeps the original no-cookie-consent-overhead reasoning above
		     intact: GA4 runs in its cookieless/modeled "ping" mode rather than
		     setting the _ga client-id cookie. Less precise than cookied GA4
		     (no cross-session user counts, some numbers are modeled/estimated),
		     but real click and page data without reopening the consent-banner
		     question this site deliberately doesn't have an answer for yet.

		     CTA clicks are sent as explicit 'cta_click' events on every element
		     with a data-cta attribute, rather than relying on GA4 Enhanced
		     Measurement's automatic "outbound click" tracking - most of the
		     real CTAs (DevServices' "#contact" anchor, the Dev nav pill's
		     "#dev" anchor, Contact's mailto: link) are same-origin or a
		     non-http(s) scheme, so Enhanced Measurement's outbound-click
		     heuristic - which only fires for <a> tags pointing at a different
		     http(s) host - would silently miss them. A single delegated
		     listener on document covers every current and future data-cta
		     element with no per-component script.

		     gtag is assigned to window explicitly (not the classic
		     `function gtag(){}` snippet Google's own docs show) because
		     Astro auto-wraps every inline <script> as an ES module - a
		     bare top-level function declaration is scoped to that module,
		     not attached to window, so any other script on the page
		     (Contact.astro's form handler, a separate module) couldn't see
		     it. Confirmed live: the bare version left `generate_lead` in
		     Contact.astro throwing "gtag is not defined" on every real
		     submission, silently swallowed by that script's own try/catch
		     and surfacing to visitors as a false "Something went wrong"
		     error even though the email itself sent successfully. -->
		<script>
			window.dataLayer = window.dataLayer || [];
			window.gtag = function gtag() { window.dataLayer.push(arguments); };
			window.gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
			});
			window.gtag('js', new Date());
			window.gtag('config', 'G-BGSJ1FWPTF');

			document.addEventListener('click', function (event) {
				var el = event.target.closest('[data-cta]');
				if (!el) return;
				window.gtag('event', 'cta_click', {
					cta_id: el.getAttribute('data-cta'),
					cta_href: el.getAttribute('href') || '',
				});
			});
		</script>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-BGSJ1FWPTF"></script>
	</head>
	<body>
		<Logo />
		<StaffNav />
		<main>
			<slot />
		</main>
	</body>
</html>
