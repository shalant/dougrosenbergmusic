---
// Shared shell for the pages reached from the home page's Press timeline
// (/press, /easternblok): page header, sections, and a link back to the
// timeline. Pages default to draft (noindex) while they carry placeholder
// text (marked with <Placeholder>); pass `draft={false}` once Doug's own text
// is in, and remove the page from the sitemap filter in astro.config.mjs at
// the same time. /easternblok left draft 2026-10-16 and /press 2026-10-23.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  draft?: boolean;
  back?: { href: string; label: string };
  // Which home-page section color the page borrows (its --note-* variable):
  // the eyebrow, the notehead on the staff and each section heading's note.
  tone?: 'about' | 'highlights' | 'listen' | 'lessons' | 'contact' | 'dev';
}

const {
  title,
  description,
  eyebrow,
  heading,
  draft = true,
  back = { href: '/#press', label: 'Back to dougrosenberg.com' },
  tone = 'highlights',
} = Astro.props;
---

<BaseLayout title={title} description={description} home={false} noindex={draft}>
  <link slot="head" rel="preload" href={`${import.meta.env.BASE_URL}fonts/work-sans.woff2`} as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href={`${import.meta.env.BASE_URL}fonts/fraunces-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <slot name="head" slot="head" />
  <article class="archive" style={`--archive-tone: var(--note-${tone})`}>
    <div class="wrap">
      <header class="archive__header">
        <a class="archive__back" href={back.href}>&larr; {back.label}</a>
        <div class="archive__staff staff-lines--strong" aria-hidden="true"><span class="archive__note"></span></div>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="archive__title">{heading}</h1>
        <slot name="lead" />
      </header>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .archive {
    /* 7.75rem floor: from 768px the fixed logo is 104px tall (to y=116), and
       the back link sat 20px under that, so their tap targets overlapped. */
    padding-block: clamp(7.75rem, 12vw, 8rem) clamp(3rem, 6vw, 5rem);
    min-height: 100vh;
  }

  .archive__header {
    display: grid;
    gap: 0.6rem;
    /* rem, not ch: a ch is the width of a "0" in whichever font is active, so
       the column resized when the web font swapped in. 42rem rather than the
       old 62ch (about 38.5rem) because the lead paragraph under the title sat
       right on a wrap boundary at 1350px, three lines in the fallback face and
       two in Work Sans. */
    max-width: 42rem;
  }

  .archive__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .archive__back:hover,
  .archive__back:focus-visible {
    color: var(--brass);
  }

  /* The home page's staff motif at the top of the page: five ruled lines
     (the .staff-lines--strong gradient, cut to one staff's 49px) with a
     notehead in the page's section color sitting on the middle line. */
  .archive__staff {
    position: relative;
    height: 49px;
    margin-bottom: 0.75rem;
  }

  .archive__note {
    position: absolute;
    left: 2.5rem;
    top: 24px;
    width: 17px;
    height: 12px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--archive-tone);
    transform: rotate(-18deg);
  }

  .archive :global(.eyebrow) {
    color: var(--archive-tone);
  }

  .archive__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1;
    margin: 0;
  }

  .archive :global(.archive__lead) {
    margin: 0.5rem 0 0;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .archive :global(.archive__section) {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    gap: 1.25rem;
  }

  .archive :global(.archive__section h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 0;
  }

  /* A small notehead in the page's color leads every section heading, the
     way the home page's staff dividers mark each section. */
  .archive :global(.archive__section h2)::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.36em;
    margin-right: 0.45em;
    border-radius: 50%;
    background: var(--archive-tone);
    transform: rotate(-18deg);
    vertical-align: 0.1em;
  }

  .archive :global(.archive__section > p) {
    margin: 0;
    max-width: 38.5rem;
    color: var(--text-muted);
  }
</style>

<style is:global>
  /* "Still missing" reads as a want ad, not a progress note: a dashed amber
     frame, a WANTED label, and the way to send a clipping as a real button. */
  .archive__wanted {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 2px dashed var(--brass);
    border-radius: 6px;
    background: var(--brass-soft);
    max-width: 38.5rem;
  }

  .archive__wanted::before {
    content: 'Wanted: clippings';
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .archive__wanted > p {
    color: var(--text);
    font-size: 1.05rem;
  }

  .archive__wanted .wanted-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1.1rem;
    border-radius: 999px;
    background: var(--brass);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .archive__wanted .wanted-cta:hover,
  .archive__wanted .wanted-cta:focus-visible {
    filter: brightness(1.15);
  }
</style>
